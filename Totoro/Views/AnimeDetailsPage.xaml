<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.AnimeDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="using:Totoro.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Totoro.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  A small rounded label, used for the facts and genres  -->
        <DataTemplate x:Key="ChipTemplate" x:DataType="x:String">
            <Border
                Padding="12,4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind}" />
            </Border>
        </DataTemplate>
        <!--
            ItemsControl + WrapPanel rather than ItemsRepeater + WrapLayout: replacing the repeater's ItemsSource (when the
            full details arrive) left the last chip unrendered. These lists are tiny, so there's nothing to virtualize.
        -->
        <ItemsPanelTemplate x:Key="ChipPanel">
            <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid>
        <!--
            Hidden until everything has loaded, details and images alike (see the code-behind), so it appears all at once.
            Opacity rather than Visibility: a collapsed Image never loads, so it would never report being ready.
        -->
        <ScrollView
            x:Name="DetailsContent"
            IsHitTestVisible="False"
            Opacity="0">
            <StackPanel Padding="0,0,0,32" Spacing="24">

                <!--  Header: banner fading into the page, with the cover and title over it  -->
                <Grid Height="320">
                    <Image
                        x:Name="BannerImageElement"
                        VerticalAlignment="Center"
                        ImageFailed="OnImageDone"
                        ImageOpened="OnImageDone"
                        Source="{x:Bind local:AnimeDetailsPage.ToImageSource(ViewModel.BannerImage), Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <!--  Fades the banner into the page; reaches the page colour just before the bottom and overhangs by
                          a pixel, so the banner's antialiased bottom row doesn't show as a line  -->
                    <Rectangle Margin="0,0,0,-1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.3" Color="Transparent" />
                                <GradientStop Offset="0.95" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid
                        Padding="24,0"
                        VerticalAlignment="Bottom"
                        ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="170"
                            Height="240"
                            CornerRadius="8">
                            <Image
                                x:Name="CoverImageElement"
                                ImageFailed="OnImageDone"
                                ImageOpened="OnImageDone"
                                Source="{x:Bind local:AnimeDetailsPage.ToImageSource(ViewModel.CoverImage), Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                            <TextBlock
                                MaxLines="3"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:AnimeDetailsPage.VisibleIfAny(ViewModel.Subtitle), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Padding="24,0" Spacing="24">
                    <!--  Facts and genres  -->
                    <StackPanel Spacing="8">
                        <ItemsControl
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ChipTemplate}"
                            ItemsPanel="{StaticResource ChipPanel}"
                            ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}" />
                        <ItemsControl
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ChipTemplate}"
                            ItemsPanel="{StaticResource ChipPanel}"
                            ItemsSource="{x:Bind ViewModel.Genres, Mode=OneWay}" />
                    </StackPanel>

                    <!--  The user's list entry  -->
                    <Grid
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="16"
                        CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.TrackingStatus, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.TrackingSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                            CommandParameter="{x:Bind ViewModel.Anime, Mode=OneWay}"
                            Content="{x:Bind ViewModel.EditTrackingText, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>

                    <!--  Synopsis  -->
                    <StackPanel Spacing="8" Visibility="{x:Bind local:AnimeDetailsPage.VisibleIfAny(ViewModel.Description), Mode=OneWay}">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Synopsis" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Studios  -->
                    <StackPanel Spacing="8" Visibility="{x:Bind local:AnimeDetailsPage.VisibleIfAny(ViewModel.Studios), Mode=OneWay}">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Studios" />
                        <TextBlock Text="{x:Bind ViewModel.Studios, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>

                    <HyperlinkButton
                        Padding="0"
                        Content="{x:Bind ViewModel.LinkText, Mode=OneWay}"
                        NavigateUri="{x:Bind ViewModel.Link, Mode=OneWay}"
                        Visibility="{x:Bind local:AnimeDetailsPage.VisibleIfNotNull(ViewModel.Link), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollView>

        <!--  Shown until the content is revealed; mirrors the page's layout so the switch keeps the same shapes  -->
        <StackPanel
            x:Name="LoadingSkeleton"
            IsHitTestVisible="False"
            Spacing="24">
            <Grid Height="320">
                <toolkit:Shimmer CornerRadius="0" />
                <!--  Same fade as the real banner, so the poster and title placeholders stand out from it  -->
                <Rectangle Margin="0,0,0,-1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent" />
                            <GradientStop Offset="0.95" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid
                    Padding="24,0"
                    VerticalAlignment="Bottom"
                    ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  On a page-coloured background, so it looks like the other placeholders rather than the banner's  -->
                    <Border
                        Width="170"
                        Height="240"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="8">
                        <toolkit:Shimmer CornerRadius="8" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                        <toolkit:Shimmer
                            Width="320"
                            Height="24"
                            HorizontalAlignment="Left"
                            CornerRadius="4" />
                        <toolkit:Shimmer
                            Width="200"
                            Height="16"
                            HorizontalAlignment="Left"
                            CornerRadius="4" />
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Padding="24,0" Spacing="24">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <toolkit:Shimmer Width="44" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="72" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="88" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="56" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="96" Height="24" CornerRadius="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <toolkit:Shimmer Width="80" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="64" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="76" Height="24" CornerRadius="12" />
                    </StackPanel>
                </StackPanel>

                <toolkit:Shimmer Height="76" CornerRadius="8" />

                <StackPanel Spacing="10">
                    <toolkit:Shimmer
                        Width="90"
                        Height="16"
                        HorizontalAlignment="Left"
                        CornerRadius="4" />
                    <toolkit:Shimmer Height="14" CornerRadius="4" />
                    <toolkit:Shimmer Height="14" CornerRadius="4" />
                    <toolkit:Shimmer Height="14" CornerRadius="4" />
                    <toolkit:Shimmer
                        Width="360"
                        Height="14"
                        HorizontalAlignment="Left"
                        CornerRadius="4" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
