<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.AnimeDetails.MusicTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views.AnimeDetails"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels.AnimeDetails">

    <Grid Padding="24,0">
        <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.InvertedBooleanToVisibility(ViewModel.IsLoaded), Mode=OneWay}">
            <toolkit:Shimmer Height="64" CornerRadius="8" />
            <toolkit:Shimmer Height="64" CornerRadius="8" />
            <toolkit:Shimmer Height="64" CornerRadius="8" />
        </StackPanel>
        <StackPanel Spacing="24" Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.IsLoaded), Mode=OneWay}">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}" />
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.PlayError, Mode=OneWay}"
                Severity="Warning"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.PlayError), Mode=OneWay}" />

            <!--  Openings, endings and insert songs, each under its heading  -->
            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="24" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongGroup">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Header}" />
                            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Songs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SongItem">
                                        <!--
                                            A card per song: its label (OP1, ED2, IN), title, who sings it and the episodes it's in. While
                                            its audio plays (or is paused), the spectrum, how far through it is, and the time, under them.
                                        -->
                                        <Grid
                                            Padding="12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            ColumnSpacing="12"
                                            CornerRadius="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Height="28"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Label}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    IsTextSelectionEnabled="True"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Details}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Details)}" />
                                            </StackPanel>
                                            <!--  Its audio, played here; its creditless video, in the media player  -->
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                                    Click="OnAudioClick"
                                                    ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}"
                                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(HasAudio)}">
                                                    <FontIcon FontSize="14" Glyph="{x:Bind AudioGlyph, Mode=OneWay}" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="{x:Bind VideoName}"
                                                    Click="OnVideoClick"
                                                    ToolTipService.ToolTip="{x:Bind VideoName}"
                                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(HasVideo)}">
                                                    <FontIcon FontSize="14" Glyph="&#xE714;" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                Margin="0,12,0,0"
                                                Spacing="8"
                                                Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                                                <!--  Only while it's heard: not while it's starting, or paused  -->
                                                <local:SongSpectrum
                                                    Height="40"
                                                    BarBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                    IsActive="{x:Bind IsAudible, Mode=OneWay}"
                                                    Source="{x:Bind Player}"
                                                    Visibility="{x:Bind IsAudible, Mode=OneWay}" />
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Song position"
                                                        IsIndeterminate="{x:Bind IsLoading, Mode=OneWay}"
                                                        Maximum="1"
                                                        Value="{x:Bind Progress, Mode=OneWay}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind TimeText, Mode=OneWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="From AnimeThemes."
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Groups), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
