<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Test.SettingsEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Totoro.UI.Controls">

    <!--
        DataContainerEditor: the editor inline on the left (edits apply straight away), the values it produces on the right,
        and the dialog version, which edits a copy and applies it only when saved.
    -->
    <Grid ColumnSpacing="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Settings editor" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.EditInDialogCommand}"
                Content="Edit in dialog"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <controls:DataContainerEditor Properties="{x:Bind ViewModel.Settings}" />
        </ScrollView>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Spacing="8">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Values" />
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Values, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.DialogResult, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
