<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.UserListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filtering="using:Totoro.Core.Filtering"
    xmlns:local="using:Totoro.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:toolkitui="using:CommunityToolkit.WinUI"
    xmlns:ui="using:Totoro.UI"
    xmlns:overlays="using:Totoro.UI.Controls.AnimeCardOverlays"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Sub-buttons of each card's floating action button; each Command receives the card's AnimeModel  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Play}"
                Label="Play" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit" />
            <overlays:CardAction Icon="{toolkitui:SymbolIconSource Symbol=Download}" Label="Download" />
        </overlays:CardActionCollection>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <toolkit:Segmented
            Grid.Row="0"
            Margin="16,0,16,16"
            HorizontalAlignment="Center"
            ItemsSource="{x:Bind ViewModel.StatusFilter.Options, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.StatusFilter.SelectedIndex, Mode=TwoWay}">
            <toolkit:Segmented.ItemTemplate>
                <!--  The item's default style sets its own FontSize, so size the text here rather than on the Segmented  -->
                <DataTemplate x:DataType="filtering:FilterOption">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center">
                            <ContentPresenter Content="{x:Bind ui:Icons.FromKey(IconKey)}" />
                        </Viewbox>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyLargeStrongTextBlockStyle}"
                            Text="{x:Bind Label}" />
                    </StackPanel>
                </DataTemplate>
            </toolkit:Segmented.ItemTemplate>
            <toolkit:Segmented.ItemContainerStyle>
                <!--  No BasedOn needed: the control's theme style (and its template) still applies underneath  -->
                <Style TargetType="toolkit:SegmentedItem">
                    <Setter Property="MinWidth" Value="160" />
                    <Setter Property="Padding" Value="24,12" />
                </Style>
            </toolkit:Segmented.ItemContainerStyle>

        </toolkit:Segmented>

        <!--  As in the Store: the filters (title, genres, season, year) and sorting show only while Filters is on; it's right of the tabs  -->
        <ToggleButton
            Margin="16,0,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="Filters"
            IsChecked="{x:Bind ViewModel.ShowFilters, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="16" Glyph="&#xE71C;" />
                <TextBlock Text="Filters" />
            </StackPanel>
        </ToggleButton>

        <!--  The filters on a card of their own: a surface's padding (16)  -->
        <Border
            Grid.Row="1"
            Margin="16,0,16,8"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Visibility="{x:Bind ViewModel.ShowFilters, Mode=OneWay}">
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation
                    From="0"
                    To="1"
                    Duration="0:0:0.2" />
                <animations:TranslationAnimation
                    From="0,-16,0"
                    To="0"
                    Duration="0:0:0.2" />
            </animations:Implicit.ShowAnimations>
            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation
                    From="1"
                    To="0"
                    Duration="0:0:0.15" />
                <animations:TranslationAnimation
                    From="0"
                    To="0,-16,0"
                    Duration="0:0:0.15" />
            </animations:Implicit.HideAnimations>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <AutoSuggestBox
                    Width="260"
                    AutomationProperties.Name="Search your list"
                    PlaceholderText="Search your list"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.TitleFilter.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <DropDownButton AutomationProperties.Name="Genres" Content="{x:Bind ViewModel.GenreFilter.Label, Mode=OneWay}">
                    <DropDownButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <ScrollViewer MaxHeight="360">
                                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.GenreFilter.Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="anime:GenreOption">
                                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <ComboBox
                    MinWidth="140"
                    AutomationProperties.Name="Season"
                    ItemsSource="{x:Bind ViewModel.SeasonFilter.Seasons}"
                    SelectedItem="{x:Bind ViewModel.SeasonFilter.Season, Mode=TwoWay}" />
                <ComboBox
                    MinWidth="120"
                    AutomationProperties.Name="Year"
                    ItemsSource="{x:Bind ViewModel.SeasonFilter.Years}"
                    SelectedItem="{x:Bind ViewModel.SeasonFilter.Year, Mode=TwoWay}" />

                <!--  Always there, so it's found; enabled once a filter's set  -->
                <Button
                    Command="{x:Bind ViewModel.ClearFiltersCommand}"
                    Content="Clear filters"
                    IsEnabled="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    MinWidth="160"
                    AutomationProperties.Name="Sort by"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.Sort, Mode=TwoWay}" />
                <Button
                    AutomationProperties.Name="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" />
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <toolkit:SwitchPresenter
            Grid.Row="2"
            TargetType="x:Boolean"
            Value="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <!--  The cards slide to their new place when the filters open or close, rather than jump. Only on the cards: the filters,
                  never laid out while collapsed, would also slide down from the top the first time they show  -->
            <toolkit:SwitchPresenter.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </toolkit:SwitchPresenter.Transitions>
            <toolkit:Case Value="True">
                <!--  Placeholder cards laid out like the real grid, so the page doesn't jump when the list arrives  -->
                <ItemsRepeater Margin="16,8,16,16" ItemsSource="{x:Bind PlaceholderCards}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <toolkit:Shimmer CornerRadius="8" />
                                <toolkit:Shimmer
                                    Grid.Row="1"
                                    Height="20"
                                    Margin="24,0"
                                    CornerRadius="4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="32"
                            MinItemHeight="400"
                            MinItemWidth="250"
                            MinRowSpacing="32" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </toolkit:Case>
            <toolkit:Case IsDefault="True" Value="False">
                <Grid>
                    <ScrollView x:Name="ListScrollView" ViewChanged="OnListViewChanged">
                        <ItemsRepeater Margin="16,8,16,16" ItemsSource="{x:Bind ViewModel.Anime, Mode=OneWay}">
                            <ItemsRepeater.ItemTransitionProvider>
                                <controls:CardCollectionTransitionProvider />
                            </ItemsRepeater.ItemTransitionProvider>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="anime:AnimeModel">
                                    <controls:AnimeCard Anime="{x:Bind}" Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}">
                                        <Interactivity:Interaction.Behaviors>
                                            <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                                            <overlays:NextEpisodeOverlay />
                                            <overlays:NewEpisodesOverlay />
                                            <overlays:AiringStatusOverlay />
                                            <overlays:HoverEffectsBehavior />
                                        </Interactivity:Interaction.Behaviors>
                                    </controls:AnimeCard>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="32"
                                    MinItemHeight="400"
                                    MinItemWidth="250"
                                    MinRowSpacing="32" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>

                    <!--  Shown once the list is scrolled down by more than a screen (see OnListViewChanged)  -->
                    <Button
                        x:Name="GoToTopButton"
                        Width="48"
                        Height="48"
                        Margin="0,0,32,32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Back to top"
                        BorderThickness="1"
                        Click="OnGoToTopClick"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Back to top"
                        Visibility="Collapsed">
                        <Button.Resources>
                            <!--  Thin black ring like the cards' floating buttons; AccentButtonStyle swaps these brushes per state  -->
                            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Black" />
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Black" />
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Black" />
                        </Button.Resources>
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation
                                From="0"
                                To="1"
                                Duration="0:0:0.2" />
                            <animations:TranslationAnimation
                                From="0,24,0"
                                To="0"
                                Duration="0:0:0.2" />
                        </animations:Implicit.ShowAnimations>
                        <animations:Implicit.HideAnimations>
                            <animations:OpacityAnimation
                                From="1"
                                To="0"
                                Duration="0:0:0.15" />
                            <animations:TranslationAnimation
                                From="0"
                                To="0,24,0"
                                Duration="0:0:0.15" />
                        </animations:Implicit.HideAnimations>
                        <FontIcon FontSize="18" Glyph="&#xE74A;" />
                    </Button>
                </Grid>
            </toolkit:Case>
        </toolkit:SwitchPresenter>
    </Grid>
</Page>
