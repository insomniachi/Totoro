<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <Grid RowSpacing="12" Padding="0,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Notification Banner when Restart is Needed -->
        <InfoBar
            Grid.Row="0"
            IsOpen="{x:Bind ViewModel.RequiresRestart, Mode=OneWay}"
            Severity="Warning"
            Title="Restart Required"
            Message="A plugin was installed, updated, or removed. Restart Totoro to apply changes.">
            <InfoBar.ActionButton>
                <Button
                    Content="Restart Totoro"
                    Command="{x:Bind ViewModel.RestartAppCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Header with Title, Search & Action Buttons -->
        <Grid Grid.Row="1" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Plugins &amp; Extensions" />
                <TextBlock
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Discover, install, and manage community anime providers and extensions." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox
                    Width="200"
                    PlaceholderText="Search plugins..."
                    Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Command="{x:Bind ViewModel.LoadCatalogCommand}"
                    ToolTipService.ToolTip="Refresh online catalog">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button
                    Click="OnBrowsePluginPackageClicked"
                    ToolTipService.ToolTip="Install a .totoro-plugin package from your computer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="Install from file..." />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Online Catalog / Store -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="12">
                <ProgressBar
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                    HorizontalAlignment="Stretch" />

                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.CatalogPlugins, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginItemViewModel">
                            <toolkit:SettingsCard
                                Header="{x:Bind Name}"
                                Description="{x:Bind Description}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEA86;" />
                                </toolkit:SettingsCard.HeaderIcon>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <!-- Update Available State -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind UpdateVisibility, Mode=OneWay}">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="UPDATE AVAILABLE" FontSize="10" Foreground="White" />
                                        </Border>
                                        <TextBlock
                                            Text="{x:Bind Version}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Content="Update"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Command="{x:Bind InstallOrUpdateCommand}" />
                                    </StackPanel>

                                    <!-- Installed & Up-to-date State -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind InstalledVisibility, Mode=OneWay}">
                                        <TextBlock
                                            Text="{x:Bind InstalledVersion}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                        <Border
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsDev)}">
                                            <TextBlock Text="DEV ACTIVE" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Button
                                            Content="Uninstall"
                                            Command="{x:Bind UninstallCommand}" />
                                    </StackPanel>

                                    <!-- Not Installed State -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind NotInstalledVisibility, Mode=OneWay}">
                                        <TextBlock
                                            Text="{x:Bind Version}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Content="Install"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Command="{x:Bind InstallOrUpdateCommand}" />
                                    </StackPanel>

                                    <!-- Progress & Status Text -->
                                    <ProgressBar
                                        IsIndeterminate="True"
                                        Width="60"
                                        Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
