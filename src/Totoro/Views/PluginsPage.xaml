<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:vm="using:Totoro.ViewModels">

    <!--  Laid out like Settings, but full width so the card grid adds columns as the window grows  -->
    <ScrollView>
        <StackPanel Margin="16" Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Plugins" />
            <TextBlock
                Margin="0,8,0,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Plugins add anime providers, the sites Totoro finds episodes on, torrent streamers, media players and more. Install them from the catalog, or from a .totoro-plugin file, and change their settings here."
                TextWrapping="Wrap" />

            <!--  Collapsed while closed (a closed info bar keeps its margin); open, 24 above the next section like one  -->
            <InfoBar
                Margin="0,0,0,20"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.RequiresRestart, Mode=OneWay}"
                Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.RequiresRestart), Mode=OneWay}"
                Severity="Informational">
                <!--  Text and button as content, not Title/Message/ActionButton: those sit in a row sized to them, so the button can't go to the right edge  -->
                <Grid Margin="0,0,16,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Restart to apply changes" />
                        <Run Text="  Plugins were installed or uninstalled. They take effect once Totoro restarts." />
                    </TextBlock>
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.RestartAppCommand}"
                        Content="Restart now" />
                </Grid>
            </InfoBar>
            <InfoBar
                Margin="0,0,0,20"
                IsOpen="{x:Bind helpers:CommonConverters.IsAny(ViewModel.StatusMessage), Mode=OneWay}"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.StatusMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Error" />

            <Grid Margin="0,0,0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  8 between buttons, per the Windows guidelines  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <AutoSuggestBox
                        Width="240"
                        AutomationProperties.Name="Search plugins"
                        PlaceholderText="Search plugins"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        AutomationProperties.Name="Refresh"
                        Command="{x:Bind ViewModel.LoadCatalogCommand}"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Test anime providers"
                        Command="{x:Bind ViewModel.TestPluginsCommand}"
                        Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.ShowsTestPlugins), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xF196;" />
                            <TextBlock Text="Test anime providers" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Install from file" Click="OnBrowsePluginPackageClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                            <TextBlock Text="Install from file" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Pills filtering the list by module type (anime providers, torrent streamers, media players…)  -->
            <labs:TokenView
                Margin="0,8,0,12"
                AutomationProperties.Name="Plugin type"
                IsWrapped="True"
                ItemsSource="{x:Bind ViewModel.TypeFilters}"
                SelectedIndex="{x:Bind ViewModel.SelectedTypeIndex, Mode=TwoWay}"
                SelectionMode="Single" />

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.IsLoadingCatalog), Mode=OneWay}" />

            <!--  Fixed card height: UniformGridLayout sizes every item like the first, so long text trims (full text in the tooltip) instead of clipping  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="4"
                        MinItemWidth="300"
                        MinRowSpacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginItemViewModel">
                        <Grid
                            Height="188"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox
                                    Width="32"
                                    Height="32"
                                    Child="{x:Bind helpers:CommonConverters.ToIcon(Icon, '&#xEA86;')}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind VersionText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind VersionText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                                <TextBlock
                                    MaxLines="1"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ShowsStatus), Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    IsTextSelectionEnabled="True"
                                    MaxLines="1"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(HasError), Mode=OneWay}" />
                            </StackPanel>

                            <!--  8 between buttons, per the Windows guidelines  -->
                            <StackPanel
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Settings"
                                    Command="{x:Bind Settings.EditCommand}"
                                    ToolTipService.ToolTip="Settings"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ShowsSettings), Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                                </Button>
                                <controls:BusyButton
                                    MinWidth="120"
                                    Command="{x:Bind InstallOrUpdateCommand}"
                                    IsBusy="{x:Bind InstallOrUpdateCommand.IsRunning, Mode=OneWay}"
                                    Content="Update"
                                    IsEnabled="{x:Bind IsCompatible}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ShowsUpdate), Mode=OneWay}" />
                                <controls:BusyButton
                                    MinWidth="120"
                                    Command="{x:Bind UninstallCommand}"
                                    IsBusy="{x:Bind UninstallCommand.IsRunning, Mode=OneWay}"
                                    Content="Uninstall"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ShowsUninstall), Mode=OneWay}" />
                                <controls:BusyButton
                                    MinWidth="120"
                                    Command="{x:Bind InstallOrUpdateCommand}"
                                    IsBusy="{x:Bind InstallOrUpdateCommand.IsRunning, Mode=OneWay}"
                                    Content="Install"
                                    IsEnabled="{x:Bind IsCompatible}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ShowsNotInstalled), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollView>
</Page>
