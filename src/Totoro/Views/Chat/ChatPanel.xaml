<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.Chat.ChatPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:Totoro.Views.Chat"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:services="using:Totoro.Core.Services">

    <UserControl.Resources>
        <chat:ChatEntryTemplateSelector x:Key="EntryTemplateSelector">
            <!--  The user's message: a bubble on the right, in the accent color  -->
            <chat:ChatEntryTemplateSelector.User>
                <DataTemplate x:DataType="services:ChatUserEntry">
                    <Border
                        MaxWidth="300"
                        Padding="12,8"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8">
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </chat:ChatEntryTemplateSelector.User>

            <chat:ChatEntryTemplateSelector.Reply>
                <DataTemplate x:DataType="services:ChatReplyEntry">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </chat:ChatEntryTemplateSelector.Reply>

            <!--  A tool the assistant used: a spinner while it runs, then a tick or a cross  -->
            <chat:ChatEntryTemplateSelector.Tool>
                <DataTemplate x:DataType="services:ChatToolEntry">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="16"
                            Height="16"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind chat:ChatPanel.IsRunning(State), Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind chat:ChatPanel.VisibleIfDone(State), Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE711;"
                                Visibility="{x:Bind chat:ChatPanel.VisibleIfFailed(State), Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Title}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IsTextSelectionEnabled="True"
                                MaxLines="2"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Arguments}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind Arguments}"
                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Arguments)}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Error, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Error), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </chat:ChatEntryTemplateSelector.Tool>

            <!--  A tool waiting for the user's say-so, e.g. removing an anime from their list  -->
            <chat:ChatEntryTemplateSelector.Approval>
                <DataTemplate x:DataType="services:ChatApprovalEntry">
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap">
                                <Run Text="Allow" />
                                <Run Text="{x:Bind Title}" /><Run Text="?" />
                            </TextBlock>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Arguments}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Arguments)}" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind chat:ChatPanel.VisibleIfPending(State), Mode=OneWay}">
                                <Button
                                    Click="OnAllowClick"
                                    Content="Allow"
                                    Style="{ThemeResource AccentButtonStyle}" />
                                <Button Click="OnDenyClick" Content="Don't allow" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind chat:ChatPanel.AnswerText(State), Mode=OneWay}"
                                Visibility="{x:Bind chat:ChatPanel.VisibleIfAnswered(State), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </chat:ChatEntryTemplateSelector.Approval>

            <chat:ChatEntryTemplateSelector.Error>
                <DataTemplate x:DataType="services:ChatErrorEntry">
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Message}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </chat:ChatEntryTemplateSelector.Error>
            <!--  Anime the assistant showed: a card each, with what the app's cards do (open, edit the list entry, play)  -->
            <chat:ChatEntryTemplateSelector.Anime>
                <DataTemplate x:DataType="services:ChatAnimeEntry">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{x:Bind Anime}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ChatAnimeItem">
                                    <!--  One compact row: poster, title and a line of facts, and icon buttons  -->
                                    <Grid
                                        Padding="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        ColumnSpacing="12"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                                        ToolTipService.ToolTip="{x:Bind FullTitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="40"
                                            Height="56"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Anime.Image)}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="0">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Anime.Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                Text="{x:Bind Facts}" />
                                            <TextBlock
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ListStatus, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ListStatus), Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <Button
                                                AutomationProperties.Name="Details"
                                                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                                                CommandParameter="{x:Bind Anime}"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="Details">
                                                <FontIcon FontSize="14" Glyph="&#xE946;" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{x:Bind ListAction, Mode=OneWay}"
                                                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                                                CommandParameter="{x:Bind Anime}"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind ListAction, Mode=OneWay}">
                                                <FontIcon FontSize="14" Glyph="{x:Bind ListGlyph, Mode=OneWay}" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="Play"
                                                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                                                CommandParameter="{x:Bind Anime}"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="Play the next episode">
                                                <FontIcon
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE768;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind More}"
                            Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(More)}" />
                    </StackPanel>
                </DataTemplate>
            </chat:ChatEntryTemplateSelector.Anime>
            <!--  An anime's songs (one playing, or all of them): the Music tab's cards, which play them  -->
            <chat:ChatEntryTemplateSelector.Songs>
                <DataTemplate x:DataType="services:ChatSongEntry">
                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Songs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:SongItem">
                                <controls:SongCard Song="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </chat:ChatEntryTemplateSelector.Songs>
        </chat:ChatEntryTemplateSelector>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: the panel's name and model, starting over, closing  -->
        <Grid Padding="16,16,16,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Assistant" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Chat.ModelName, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                AutomationProperties.Name="New chat"
                Command="{x:Bind ViewModel.NewChatCommand, Mode=OneWay}"
                Style="{ThemeResource SubtleButtonStyle}"
                ToolTipService.ToolTip="New chat">
                <FontIcon FontSize="16" Glyph="&#xE710;" />
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Close"
                Click="OnCloseClick"
                Style="{ThemeResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="16" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <!--  The conversation; keeps the latest in view as the reply streams in  -->
        <ListView
            Grid.Row="1"
            Padding="16,0"
            IsItemClickEnabled="False"
            ItemTemplateSelector="{StaticResource EntryTemplateSelector}"
            ItemsSource="{x:Bind ViewModel.Chat.Entries, Mode=OneWay}"
            SelectionMode="None">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!--  Before the first message: things to try  -->
        <StackPanel
            Grid.Row="1"
            Padding="16,0"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind chat:ChatPanel.VisibleIfEmpty(ViewModel.IsAvailable, ViewModel.Chat.Entries.Count), Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Ask about your list, or have it do things for you."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OnSuggestionClick"
                            Content="{x:Bind}"
                            Tag="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  No model set up  -->
        <TextBlock
            Grid.Row="1"
            Padding="16,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="The assistant needs a model. Set one up in Settings, under Modules."
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:CommonConverters.InvertedBooleanToVisibility(ViewModel.IsAvailable), Mode=OneWay}" />

        <!--  The message box: Enter sends, Shift+Enter starts a new line  -->
        <Grid
            Grid.Row="2"
            Padding="16,0,16,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                MaxHeight="160"
                AcceptsReturn="True"
                AutomationProperties.Name="Message"
                IsEnabled="{x:Bind ViewModel.IsAvailable, Mode=OneWay}"
                PlaceholderText="Ask the assistant"
                PreviewKeyDown="OnInputPreviewKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <Grid Grid.Column="1" VerticalAlignment="Bottom">
                <Button
                    AutomationProperties.Name="Send"
                    Command="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Send"
                    Visibility="{x:Bind helpers:CommonConverters.InvertedBooleanToVisibility(ViewModel.Chat.IsBusy), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE724;" />
                </Button>
                <Button
                    AutomationProperties.Name="Stop"
                    Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Stop"
                    Visibility="{x:Bind ViewModel.Chat.IsBusy, Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE71A;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
