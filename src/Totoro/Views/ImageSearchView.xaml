<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.ImageSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:overlays="using:Totoro.UI.Controls.MediaCardOverlays"
    xmlns:services="using:Totoro.Core.Services"
    xmlns:text="using:Totoro.UI.Text"
    xmlns:toolkitui="using:CommunityToolkit.WinUI"
    xmlns:views="using:Totoro.Views">

    <UserControl.Resources>
        <!--  The Search page's main card actions; each Command receives the card's AnimeModel  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Play}"
                Label="Play"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit tracking"
                OffListIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                OffListLabel="Add to list"
                ShowOnHover="True" />
        </overlays:CardActionCollection>
        <overlays:MediaSearchOverlays x:Key="CardOverlays" />
    </UserControl.Resources>
    <!--
        Search's Image tab, as trace.moe's own page, in three columns: the image and its matches; the scene of the match
        picked, playing, centered in the room the others leave; and that match's anime, as its card. Searching (Ctrl+V,
        the Paste image button) is the Search page's.
    -->
    <Grid ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <!--  Auto: nothing until there's an image or a match, so a message has the room  -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  The image searched with, and its matches  -->
        <Grid
            Width="320"
            RowSpacing="8"
            Visibility="{x:Bind views:ImageSearchView.VisibleIfAny(ViewModel.Pasted), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Your image" />
            <Border Grid.Row="1" CornerRadius="8">
                <Image
                    AutomationProperties.AutomationId="PastedImage"
                    AutomationProperties.Name="Pasted image"
                    Source="{x:Bind ViewModel.Pasted, Mode=OneWay}"
                    Stretch="Uniform" />
            </Border>
            <TextBlock
                Grid.Row="2"
                Margin="0,8,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Matches" />
            <ListView
                Grid.Row="3"
                Margin="-16,0,0,0"
                AutomationProperties.Name="Matches"
                ItemsSource="{x:Bind ViewModel.Matches, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ImageMatch">
                        <Grid
                            Padding="0,8"
                            AutomationProperties.Name="{x:Bind Anime.Title}"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="68"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <Image Source="{x:Bind Anime.Image}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Anime.Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind views:ImageSearchView.Where(Episode, At, Similarity)}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  The match's scene: 16:9, as big as the room allows, centered so the gaps either side match  -->
        <Viewbox
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Stretch="Uniform"
            Visibility="{x:Bind views:ImageSearchView.VisibleIfAny(ViewModel.Selected), Mode=OneWay}">
                <Border
                    Width="880"
                    Height="495"
                    Background="Black"
                    CornerRadius="8">
                    <MediaPlayerElement
                        AreTransportControlsEnabled="False"
                        AutoPlay="True"
                        AutomationProperties.Name="The matched scene"
                        Source="{x:Bind ViewModel.Clip, Mode=OneWay}"
                        Stretch="Uniform" />
                </Border>
        </Viewbox>

        <!--  The match's anime: its card (Play and Add to list on it, details on a click), what it is, and its scene played  -->
        <StackPanel
            Grid.Column="2"
            Width="250"
            Spacing="12"
            Visibility="{x:Bind views:ImageSearchView.VisibleIfAny(ViewModel.Selected), Mode=OneWay}">
            <controls:MediaCard
                Height="400"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                Media="{x:Bind ViewModel.Selected.Anime, Mode=OneWay}"
                Overlays="{StaticResource CardOverlays}">
                <Interactivity:Interaction.Behaviors>
                    <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                    <overlays:HoverEffectsBehavior />
                </Interactivity:Interaction.Behaviors>
            </controls:MediaCard>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind views:ImageSearchView.Info(ViewModel.Selected), Mode=OneWay}"
                TextWrapping="Wrap" />
            <RichTextBlock
                MaxLines="5"
                text:HtmlText.Html="{x:Bind ViewModel.Selected.Anime.Description, Mode=OneWay}"
                TextTrimming="WordEllipsis" />
            <Button
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="PlaySceneButton"
                AutomationProperties.Name="{x:Bind views:ImageSearchView.PlaySceneLabel(ViewModel.Selected), Mode=OneWay}"
                Command="{x:Bind ViewModel.PlaySceneCommand}"
                CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Play" />
                    <TextBlock Text="{x:Bind views:ImageSearchView.PlaySceneLabel(ViewModel.Selected), Mode=OneWay}" />
                </StackPanel>
            </Button>
            <!--  Where the scene is, and the release it was found in  -->
            <TextBlock
                Margin="0,-4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind views:ImageSearchView.Scene(ViewModel.Selected), Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Beside the image, or the whole width before one is pasted  -->
        <StackPanel
            Grid.Column="1"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE91B;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyLargeTextBlockStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ProgressRing
            Grid.ColumnSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</UserControl>
