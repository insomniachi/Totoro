<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.DownloadEpisodesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MinWidth="400" Spacing="12">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <NumberBox
                Header="From episode"
                Maximum="{x:Bind ViewModel.MaxEpisode}"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.From, Mode=TwoWay}" />
            <NumberBox
                Grid.Column="1"
                Header="To episode"
                Maximum="{x:Bind ViewModel.MaxEpisode}"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.To, Mode=TwoWay}" />
        </Grid>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
