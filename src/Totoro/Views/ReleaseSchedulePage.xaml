<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.ReleaseSchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="using:Totoro.Commands"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views"
    xmlns:services="using:Totoro.Core.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <Page.Resources>
        <!--  A show's line on a day: its marker, title and episode numbers  -->
        <DataTemplate x:Key="EpisodeLineTemplate" x:DataType="vm:CalendarBand">
            <Grid ColumnSpacing="4" Opacity="{x:Bind local:ReleaseSchedulePage.WatchedOpacity(IsWatched)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="{x:Bind local:ReleaseSchedulePage.MarkerGlyph(Marker, IsWatched)}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Anime.Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:ReleaseSchedulePage.EpisodeLabel(First.Number, Last.Number)}" />
            </Grid>
        </DataTemplate>

        <!--  A show in a day's list (its +N more flyout); opens the anime's details  -->
        <DataTemplate x:Key="EpisodeRowTemplate" x:DataType="vm:CalendarBand">
            <Button
                Padding="4,2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind local:ReleaseSchedulePage.Describe(Anime.Title, First.Number, Last.Number, AiringAt, Marker)}"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                CommandParameter="{x:Bind Anime}"
                Content="{x:Bind}"
                ContentTemplate="{StaticResource EpisodeLineTemplate}"
                ToolTipService.ToolTip="{x:Bind local:ReleaseSchedulePage.Describe(Anime.Title, First.Number, Last.Number, AiringAt, Marker)}" />
        </DataTemplate>
    </Page.Resources>

    <!--  Spacing per the Windows guidelines: 16 padding, 12 between content areas, 8 between buttons and from a header to its control.  -->
    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Release schedule" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="When the episodes of the anime you're watching air." />
            <local:ListLoadInfoBars State="{x:Bind ViewModel.LoadState, Mode=OneWay}" Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.LoadState.HasMessage), Mode=OneWay}" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  The month, and what the markers mean  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.Name="Previous month"
                        Command="{x:Bind ViewModel.PreviousMonthCommand}"
                        ToolTipService.ToolTip="Previous month">
                        <FontIcon FontSize="16" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Next month"
                        Command="{x:Bind ViewModel.NextMonthCommand}"
                        ToolTipService.ToolTip="Next month">
                        <FontIcon FontSize="16" Glyph="&#xE76C;" />
                    </Button>
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE734;" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Season premiere" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE7C1;" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Season finale" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE73E;" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Watched" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.DayNames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <toolkit:UniformGrid ColumnSpacing="8" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <toolkit:UniformGrid
                            ColumnSpacing="8"
                            Columns="7"
                            RowSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarDay">
                        <Grid
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{x:Bind local:ReleaseSchedulePage.DayBorder(IsToday)}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Opacity="{x:Bind local:ReleaseSchedulePage.DayOpacity(IsInMonth)}">
                            <!--  A band for each show, with its cover behind its row  -->
                            <ItemsControl ItemsSource="{x:Bind Bands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <toolkit:UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <!--  The whole band opens the anime's details  -->
                                    <DataTemplate x:DataType="vm:CalendarBand">
                                        <Button
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="{x:Bind local:ReleaseSchedulePage.Describe(Anime.Title, First.Number, Last.Number, AiringAt, Marker)}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                                            CommandParameter="{x:Bind Anime}"
                                            CornerRadius="0"
                                            ToolTipService.ToolTip="{x:Bind local:ReleaseSchedulePage.Describe(Anime.Title, First.Number, Last.Number, AiringAt, Marker)}">
                                            <Grid>
                                                <!--  The cover, not the banner: AniList's banners never finish loading in an Image.  -->
                                                <Border Opacity="0.3">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{x:Bind helpers:CommonConverters.ToImageSource(Anime.Image)}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <ContentPresenter
                                                    Margin="8,0,8,6"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalContentAlignment="Stretch"
                                                    Content="{x:Bind}"
                                                    ContentTemplate="{StaticResource EpisodeLineTemplate}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <toolkit:Shimmer CornerRadius="0" Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsLoading)}" />

                            <!--  The day; today's on an accent circle  -->
                            <Grid
                                Width="24"
                                Height="24"
                                Margin="8,8,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{x:Bind local:ReleaseSchedulePage.TodayBackground(IsToday)}"
                                CornerRadius="12"
                                IsHitTestVisible="False">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind local:ReleaseSchedulePage.TodayForeground(IsToday)}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Date.Day}" />
                            </Grid>

                            <!--  The shows that don't get a band  -->
                            <Button
                                Margin="0,8,8,0"
                                Padding="8,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="{x:Bind MoreLabel}"
                                FontSize="12"
                                Visibility="{x:Bind local:ReleaseSchedulePage.VisibleIfAny(MoreCount)}">
                                <Button.Flyout>
                                    <Flyout>
                                        <ItemsControl
                                            Width="280"
                                            ItemTemplate="{StaticResource EpisodeRowTemplate}"
                                            ItemsSource="{x:Bind Shows}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Page>
