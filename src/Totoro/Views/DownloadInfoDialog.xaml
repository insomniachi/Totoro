<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.DownloadInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MinWidth="400" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="The Downloads provider finds this anime by its ids, or else by its titles."
            TextWrapping="Wrap" />
        <TextBox Header="Title" Text="{x:Bind ViewModel.AnimeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox
            Height="96"
            AcceptsReturn="True"
            Header="Other titles (one a line)"
            Text="{x:Bind ViewModel.OtherTitles, Mode=TwoWay}"
            TextWrapping="Wrap" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <NumberBox
                Header="AniList id"
                Minimum="0"
                PlaceholderText="None"
                Value="{x:Bind ViewModel.AnilistId, Mode=TwoWay}" />
            <NumberBox
                Grid.Column="1"
                Header="MyAnimeList id"
                Minimum="0"
                PlaceholderText="None"
                Value="{x:Bind ViewModel.MalId, Mode=TwoWay}" />
        </Grid>
    </StackPanel>
</UserControl>
