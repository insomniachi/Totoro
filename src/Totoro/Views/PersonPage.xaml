<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="using:Totoro.Commands"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:text="using:Totoro.UI.Text"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <!--  A character or voice actor: as the manga details page's header, then the description and their anime  -->
    <ScrollView>
        <StackPanel Padding="16" Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Height="200"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.Image), Mode=OneWay}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.NativeName, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.NativeName), Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Facts, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}" />

            <StackPanel Spacing="8" Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Description), Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="About" />
                <RichTextBlock text:HtmlText.Html="{x:Bind ViewModel.Description, Mode=OneWay}" />
            </StackPanel>

            <!--  Who voices a character: a round picture, name and language; clicking one opens their page  -->
            <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.People), Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Voiced by" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            MinColumnSpacing="16"
                            MinItemWidth="96"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonLink">
                            <Button
                                Width="96"
                                Padding="0,4"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnPersonClick"
                                Tag="{x:Bind Target, Mode=OneTime}">
                                <StackPanel Spacing="6">
                                    <PersonPicture
                                        Width="72"
                                        Height="72"
                                        DisplayName="{x:Bind Name, Mode=OneTime}"
                                        ProfilePicture="{x:Bind helpers:CommonConverters.ToImageSource(Image), Mode=OneTime}" />
                                    <!--  Fixed height: UniformGridLayout sizes every item like the first  -->
                                    <StackPanel Height="34">
                                        <TextBlock
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Name, Mode=OneTime}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle, Mode=OneTime}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!--  As the anime details page's Related tab: picture and title (and the anime, under a character); clicking one opens the anime, from the selected database  -->
            <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Cards), Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CardsHeader, Mode=OneTime}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            MinColumnSpacing="16"
                            MinItemWidth="110"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonCard">
                            <Button
                                Width="110"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind commands:AnimeCommands.Shared.ShowInDatabaseCommand, Mode=OneTime}"
                                CommandParameter="{x:Bind Anime, Mode=OneTime}"
                                ToolTipService.ToolTip="{x:Bind Anime.Title, Mode=OneTime}">
                                <StackPanel Spacing="8">
                                    <Border
                                        Height="150"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Grid>
                                            <toolkit:Shimmer CornerRadius="8" Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Image), Mode=OneTime}" />
                                            <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Image), Mode=OneTime}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <!--  Fixed heights: UniformGridLayout sizes every item like the first  -->
                                    <StackPanel Height="48">
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Title, Mode=OneTime}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle, Mode=OneTime}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Subtitle), Mode=OneTime}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
