<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Manga.MangaDiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:commands="using:Totoro.Commands"
    xmlns:overlays="using:Totoro.UI.Controls.AnimeCardOverlays"
    xmlns:toolkitui="using:CommunityToolkit.WinUI"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:manga="using:Totoro.Core.Modules.Manga">

    <Page.Resources>
        <!--  As the anime pages' cards; each Command receives the card's MangaModel  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:MangaCommands.Shared.ReadCommand}"
                Icon="{toolkitui:FontIconSource Glyph=&#xE736;}"
                Label="Read"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:MangaCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit tracking"
                OffListIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                OffListLabel="Add to list"
                ShowOnHover="True" />
        </overlays:CardActionCollection>

        <DataTemplate x:Key="CardTemplate" x:DataType="manga:MangaModel">
            <controls:AnimeCard
                Width="190"
                Height="320"
                Command="{x:Bind commands:MangaCommands.Shared.ShowDetailsCommand}"
                Media="{x:Bind}">
                <Interactivity:Interaction.Behaviors>
                    <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                    <overlays:ListStatusOverlay />
                    <overlays:MeanScoreOverlay />
                    <overlays:HoverEffectsBehavior />
                </Interactivity:Interaction.Behaviors>
            </controls:AnimeCard>
        </DataTemplate>

        <!--  The rows are the anime Discover page's (DiscoverPage.xaml), which pages them too  -->
        <Style x:Key="RowScrollViewStyle" TargetType="ScrollView">
            <Setter Property="ContentOrientation" Value="Horizontal" />
            <Setter Property="VerticalScrollMode" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="Margin" Value="-8" />
        </Style>

        <Style TargetType="ItemsRepeater">
            <Setter Property="Margin" Value="8" />
        </Style>

        <Style
            x:Key="RowHeaderStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="RowPageButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollView>
            <StackPanel Padding="16" Spacing="12">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind helpers:CommonConverters.IsAny(ViewModel.Error), Mode=OneWay}"
                    Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                    Severity="Error">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.LoadCommand}" Content="Try again" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Trending), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowHeaderStyle}" Text="Trending now" />
                        <Button
                            Grid.Column="1"
                            x:Name="TrendingPrevious"
                            AutomationProperties.Name="Previous trending manga"
                            Click="OnPreviousPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind TrendingRow}"
                            ToolTipService.ToolTip="Previous" />
                        <Button
                            Grid.Column="2"
                            x:Name="TrendingNext"
                            AutomationProperties.Name="Next trending manga"
                            Click="OnNextPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind TrendingRow}"
                            ToolTipService.ToolTip="Next" />
                    </Grid>
                    <ScrollView
                        x:Name="TrendingRow"
                        ExtentChanged="OnRowChanged"
                        ScrollAnimationStarting="OnRowScrollAnimationStarting"
                        SizeChanged="OnRowChanged"
                        Style="{StaticResource RowScrollViewStyle}"
                        ViewChanged="OnRowChanged">
                        <ItemsRepeater ItemTemplate="{StaticResource CardTemplate}" ItemsSource="{x:Bind ViewModel.Trending, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Popular), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowHeaderStyle}" Text="All-time popular" />
                        <Button
                            Grid.Column="1"
                            x:Name="PopularPrevious"
                            AutomationProperties.Name="Previous popular manga"
                            Click="OnPreviousPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind PopularRow}"
                            ToolTipService.ToolTip="Previous" />
                        <Button
                            Grid.Column="2"
                            x:Name="PopularNext"
                            AutomationProperties.Name="Next popular manga"
                            Click="OnNextPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind PopularRow}"
                            ToolTipService.ToolTip="Next" />
                    </Grid>
                    <ScrollView
                        x:Name="PopularRow"
                        ExtentChanged="OnRowChanged"
                        ScrollAnimationStarting="OnRowScrollAnimationStarting"
                        SizeChanged="OnRowChanged"
                        Style="{StaticResource RowScrollViewStyle}"
                        ViewChanged="OnRowChanged">
                        <ItemsRepeater ItemTemplate="{StaticResource CardTemplate}" ItemsSource="{x:Bind ViewModel.Popular, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>
                </StackPanel>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
