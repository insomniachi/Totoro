<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Manga.MangaDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="using:Totoro.Commands"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views.Manga"
    xmlns:manga="using:Totoro.Core.Modules.Manga"
    xmlns:text="using:Totoro.UI.Text">

    <ScrollView>
        <StackPanel Padding="16" Spacing="12">
            <!--  Cover, title, facts and the main actions  -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Height="200"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.Manga.Image)}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Manga.Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Facts}"
                        TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind local:MangaDetailsPage.ListText(ViewModel.Manga.Tracking), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.ReadNextCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRead, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE736;" />
                                <TextBlock Text="{x:Bind ViewModel.ReadText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{x:Bind commands:MangaCommands.Shared.EditTrackingCommand}"
                            CommandParameter="{x:Bind ViewModel.Manga}"
                            Content="{x:Bind local:MangaDetailsPage.TrackingButtonText(ViewModel.Manga.Tracking), Mode=OneWay}"
                            />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <RichTextBlock text:HtmlText.Html="{x:Bind ViewModel.Manga.Description}" />

            <!--  Chapters on the manga source  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Chapters" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="160"
                    AutomationProperties.Name="Manga source"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ViewModel.Sources}"
                    SelectedItem="{x:Bind ViewModel.Source, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasSources}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.MatchText, Mode=OneWay}" />
                <HyperlinkButton
                    Command="{x:Bind ViewModel.StartPickingCommand}"
                    Content="Wrong match?"
                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotNull(ViewModel.Match), Mode=OneWay}" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.ChaptersMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.ChaptersMessage), Mode=OneWay}" />

            <!--  Picking the source's manga by hand  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPicking, Mode=OneWay}">
                <AutoSuggestBox
                    AutomationProperties.Name="Search the manga source"
                    PlaceholderText="Search the source"
                    QueryIcon="Find"
                    QuerySubmitted="OnSourceSearchSubmitted"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" />
                <ListView
                    IsItemClickEnabled="True"
                    ItemClick="OnMatchClick"
                    ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="manga:ProviderManga">
                            <StackPanel
                                Padding="0,4"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Border
                                    Width="40"
                                    Height="56"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Image)}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <ListView
                IsItemClickEnabled="True"
                ItemClick="OnChapterClick"
                ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="manga:ProviderChapter">
                        <TextBlock Padding="0,8" Text="{x:Bind local:MangaDetailsPage.ChapterText(Number, Title)}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollView>
</Page>
