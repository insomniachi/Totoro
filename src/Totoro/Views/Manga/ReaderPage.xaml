<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Manga.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views.Manga"
    xmlns:vm="using:Totoro.ViewModels.Manga"
    PreviewKeyDown="OnPreviewKeyDown">

    <Page.Resources>
        <!--  A page: as big as fits, whole, in the height there is; a spinner while it loads, or Retry if it didn't  -->
        <DataTemplate x:Key="FitPageTemplate" x:DataType="vm:ReaderPageItem">
            <Grid AutomationProperties.Name="{x:Bind Name}">
                <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind IsFailed, Mode=OneWay}">
                    <TextBlock Text="{x:Bind local:ReaderPage.FailedText(Number)}" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="OnRetryClick"
                        Content="Retry"
                        Tag="{x:Bind}" />
                </StackPanel>
                <Image
                    AutomationProperties.Name="{x:Bind Name}"
                    Source="{x:Bind Image, Mode=OneWay}"
                    Stretch="Uniform" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root">
        <InfoBar
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsClosable="False"
            IsOpen="{x:Bind helpers:CommonConverters.IsAny(ViewModel.Error), Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.LoadChapterCommand}" Content="Try again" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--
            A page (or two, side by side) at a time, fitted to the height; right to left for manga. Turned by the keys or
            buttons, the page turns over as a book's does (see Turn) rather than sliding, which only swipes still do.
        -->
        <FlipView
            x:Name="PagedView"
            Background="Transparent"
            FlowDirection="{x:Bind local:ReaderPage.Direction(ViewModel.IsRightToLeft), Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Spreads, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.SpreadIndex, Mode=TwoWay}"
            SelectionChanged="OnSpreadChanged"
            UseTouchAnimationsForAllNavigation="False">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="vm:ReaderSpread">
                    <!--
                        Pages read the same way whatever the flip direction (ReaderSpread puts them in order). The content is
                        the view's size, so a page fits without scrolling; Ctrl+wheel still zooms in, and then it scrolls.
                    -->
                    <ScrollView
                        ContentOrientation="None"
                        FlowDirection="LeftToRight"
                        ZoomMode="Enabled">
                        <!--  A narrow gap between two pages, as between a book's facing pages  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <!--  One page in the middle, or two meeting at it  -->
                            <ContentControl
                                Grid.ColumnSpan="{x:Bind local:ReaderPage.LeftSpan(IsSingle)}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="{x:Bind local:ReaderPage.LeftAlignment(IsSingle)}"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind Left}"
                                ContentTemplate="{StaticResource FitPageTemplate}"
                                IsTabStop="False" />
                            <ContentControl
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind Right}"
                                ContentTemplate="{StaticResource FitPageTemplate}"
                                IsTabStop="False"
                                Visibility="{x:Bind local:ReaderPage.VisibleIfTwo(IsSingle)}" />
                        </Grid>
                    </ScrollView>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <!--  Over the pages while one turns: copies of the pages that move and the shadows they cast (see Turn)  -->
        <Canvas x:Name="TurnLayer" IsHitTestVisible="False" />

        <!--
            The bar: where you are, and going about the chapters. Over the pages, and only while wanted (see ShowBar):
            reading is the pages alone. Faded rather than collapsed, so Tab still reaches it.
        -->
        <CommandBar
            x:Name="Bar"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            Canvas.ZIndex="2"
            DefaultLabelPosition="Collapsed"
            GotFocus="OnBarGotFocus"
            IsHitTestVisible="False"
            Opacity="0"
            OverflowButtonVisibility="Collapsed"
            VerticalContentAlignment="Center"
            PointerEntered="OnBarPointerEntered"
            PointerExited="OnBarPointerExited">
            <CommandBar.OpacityTransition>
                <ScalarTransition />
            </CommandBar.OpacityTransition>
            <CommandBar.Content>
                <StackPanel Margin="12,4" VerticalAlignment="Center">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.MangaTitle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.MangaTitle)}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:ReaderPage.Where(ViewModel.ChapterTitle, ViewModel.PageText), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <!--  What finishing a chapter saved to the user's list  -->
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.TrackingText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.TrackingText), Mode=OneWay}" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <Slider
                    Width="200"
                    Margin="8,0"
                    AutomationProperties.Name="Page"
                    IsDirectionReversed="{x:Bind ViewModel.IsRightToLeft, Mode=OneWay}"
                    Maximum="{x:Bind ViewModel.PageCount, Mode=OneWay}"
                    Minimum="1"
                    Value="{x:Bind ViewModel.PageNumber, Mode=TwoWay}" />
            </AppBarElementContainer>
            <AppBarButton
                Command="{x:Bind ViewModel.PreviousChapterCommand}"
                IsEnabled="{x:Bind ViewModel.HasPrevious, Mode=OneWay}"
                Label="Previous chapter"
                ToolTipService.ToolTip="Previous chapter">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE892;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Command="{x:Bind ViewModel.NextChapterCommand}"
                IsEnabled="{x:Bind ViewModel.HasNext, Mode=OneWay}"
                Label="Next chapter"
                ToolTipService.ToolTip="Next chapter">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE893;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <!--  Two pages side by side, a page at a time  -->
            <AppBarToggleButton
                IsChecked="{x:Bind ViewModel.TwoPages, Mode=TwoWay}"
                Label="Two pages"
                ToolTipService.ToolTip="Two pages side by side">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE89A;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <!--  Right to left, as most manga read; the arrow keys follow  -->
            <AppBarToggleButton
                IsChecked="{x:Bind ViewModel.IsRightToLeft, Mode=TwoWay}"
                Label="Right to left"
                ToolTipService.ToolTip="Read right to left, as most manga">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE72B;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
        </CommandBar>
    </Grid>
</Page>
