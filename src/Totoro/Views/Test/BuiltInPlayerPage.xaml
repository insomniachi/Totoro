<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Test.BuiltInPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  The built-in player: play any video, and try what it offers over the video  -->
    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="12">
        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Built-in player" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Plays a video in the built-in player, with an opening marked from 0:10 to 1:40 and an ending in the last 1:30. The buttons below show what the player offers over the video."
            TextWrapping="Wrap" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                AutomationProperties.Name="Video"
                PlaceholderText="A file path or URL"
                Text="{x:Bind ViewModel.Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.PlayCommand}"
                Content="Play"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.OfferSkipCommand}" Content="Offer to skip" />
            <Button Command="{x:Bind ViewModel.OfferNextCommand}" Content="Offer the next episode" />
            <Button Command="{x:Bind ViewModel.ShowStatusCommand}" Content="Show a status" />
            <Button Command="{x:Bind ViewModel.ShowMessageCommand}" Content="Show a message" />
        </StackPanel>
        <TextBlock AutomationProperties.AutomationId="PlayerResult" Text="{x:Bind ViewModel.Result, Mode=OneWay}" />
    </StackPanel>
</Page>
