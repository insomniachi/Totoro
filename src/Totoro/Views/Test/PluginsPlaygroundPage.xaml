<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Test.PluginsPlaygroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:plugins="using:Totoro.Core.Plugins"
    xmlns:streaming="using:Totoro.Core.Modules.Streaming"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vmTest="using:Totoro.ViewModels.Test">

    <Grid RowSpacing="12" Padding="0,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Notification Banner when Restart is Needed -->
        <InfoBar
            Grid.Row="0"
            IsOpen="{x:Bind ViewModel.RequiresRestart, Mode=OneWay}"
            Severity="Warning"
            Title="Restart Required"
            Message="A plugin was installed, updated, or removed. Restart Totoro to apply changes.">
            <InfoBar.ActionButton>
                <Button
                    Content="Restart Totoro"
                    Command="{x:Bind ViewModel.RestartAppCommand}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Header with Title & Action Buttons -->
        <Grid Grid.Row="1" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Plugins &amp; Extensions" />
                <TextBlock
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Browse community anime providers, download updates, or configure external plugins." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.LoadCatalogCommand}"
                    ToolTipService.ToolTip="Refresh online catalog">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button
                    Click="OnBrowsePluginPackageClicked"
                    ToolTipService.ToolTip="Install a .totoro-plugin package from your computer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="Install from file..." />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation Tabs -->
        <SelectorBar
            Grid.Row="2"
            Margin="-8,0,0,0"
            SelectionChanged="OnTabSelectionChanged">
            <SelectorBarItem
                IsSelected="True"
                Tag="0"
                Text="Online Catalog (Store)" />
            <SelectorBarItem Tag="1" Text="Installed &amp; Dev" />
            <SelectorBarItem Tag="2" Text="Provider Playground" />
        </SelectorBar>

        <!-- Tab 0: Online Catalog / Store -->
        <Grid x:Name="CatalogSection" Grid.Row="3" Visibility="Visible">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="12">
                    <ProgressBar
                        IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />

                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CatalogPlugins, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmTest:PluginItemViewModel">
                                <toolkit:SettingsCard
                                    Header="{x:Bind Name}"
                                    Description="{x:Bind Description}">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xEA86;" />
                                    </toolkit:SettingsCard.HeaderIcon>

                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <!-- Update Available State -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind UpdateVisibility, Mode=OneWay}">
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="UPDATE AVAILABLE" FontSize="10" Foreground="White" />
                                            </Border>
                                            <TextBlock
                                                Text="{x:Bind Version}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Content="Update"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Command="{x:Bind InstallOrUpdateCommand}" />
                                        </StackPanel>

                                        <!-- Installed & Up-to-date State -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind InstalledVisibility, Mode=OneWay}">
                                            <TextBlock
                                                Text="{x:Bind InstalledVersion}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Content="Uninstall"
                                                Command="{x:Bind UninstallCommand}" />
                                        </StackPanel>

                                        <!-- Not Installed State -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind NotInstalledVisibility, Mode=OneWay}">
                                            <TextBlock
                                                Text="{x:Bind Version}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Content="Install"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Command="{x:Bind InstallOrUpdateCommand}" />
                                        </StackPanel>

                                        <!-- Progress & Status Text -->
                                        <ProgressBar
                                            IsIndeterminate="True"
                                            Width="60"
                                            Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tab 1: Installed & Dev Paths -->
        <Grid x:Name="InstalledSection" Grid.Row="3" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="16">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Active In-Memory Plugins" />
                    <ListView
                        ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="plugins:PluginInfo">
                                <toolkit:SettingsCard Header="{x:Bind Name}" Description="{x:Bind Description}">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE74C;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Version}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsDev)}">
                                            <TextBlock Text="DEV" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </toolkit:SettingsCard>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Local Dev Directories" Margin="0,16,0,0" />
                    <TextBlock
                        Text="Folders scanned automatically for debug plugin binaries on startup:"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView ItemsSource="{x:Bind ViewModel.DevPaths, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Remove" Click="OnRemoveDevPathClicked" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind ViewModel.NewDevPath, Mode=TwoWay}" PlaceholderText="C:\path\to\plugin\bin\Debug\net10.0" />
                        <Button Grid.Column="1" Content="Add Dev Path" Command="{x:Bind ViewModel.AddDevPathCommand}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tab 2: Anime Provider Test Playground -->
        <Grid x:Name="PlaygroundSection" Grid.Row="3" Visibility="Collapsed" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search & Show Selection -->
            <StackPanel Spacing="12">
                <ComboBox
                    Header="Active Anime Provider"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.AvailableProviders, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="streaming:IAnimeProvider">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" PlaceholderText="Anime title..." />
                    <Button Grid.Column="1" Content="Search" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SearchShowsCommand}" />
                </Grid>

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.SearchingVisibility, Mode=OneWay}" />

                <TextBlock Text="Search Results" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ListView
                    ItemsSource="{x:Bind ViewModel.Shows, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedShow, Mode=TwoWay}"
                    MaxHeight="360"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="streaming:ProviderShow">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Padding="0,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Episodes & Stream Results -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Episodes" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="Fetch Episodes" Command="{x:Bind ViewModel.GetEpisodesCommand}" IsEnabled="{x:Bind ViewModel.CanFetchEpisodes, Mode=OneWay}" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedEpisode, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="streaming:ProviderEpisode">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Id}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Video Streams" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="Fetch Streams" Command="{x:Bind ViewModel.GetServersCommand}" IsEnabled="{x:Bind ViewModel.CanFetchServers, Mode=OneWay}" />
                </StackPanel>

                <ListView
                    Grid.Row="3"
                    ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="streaming:VideoServer">
                            <StackPanel Spacing="2" Padding="0,4">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Url}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
