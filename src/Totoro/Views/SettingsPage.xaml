<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <!--  The categories, each a page of its own (Views/Settings); the cards' CommandParameters are their navigation keys (see SettingsViewModel)  -->
    <ScrollView>
        <StackPanel
            MaxWidth="1000"
            Margin="16"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,24"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Settings" />

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenCommand}"
                CommandParameter="Settings.General"
                Description="Startup page, theme and backdrop"
                Header="General"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenCommand}"
                CommandParameter="Settings.Accounts"
                Description="Anime database, signing in, and keeping your lists in sync"
                Header="Accounts"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE77B;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenCommand}"
                CommandParameter="Settings.Playback"
                Description="Anime provider, media player, skipping, the next episode, Discord"
                Header="Playback"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE768;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenCommand}"
                CommandParameter="Settings.Downloads"
                Description="Download folder and yt-dlp"
                Header="Downloads"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenCommand}"
                CommandParameter="Settings.Modules"
                Description="Plugins, and each module's own settings"
                Header="Modules &amp; plugins"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA86;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenCommand}"
                CommandParameter="Settings.About"
                Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                Header="About &amp; updates"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
