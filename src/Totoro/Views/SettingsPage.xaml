<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="using:Totoro.Core.Navigation"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel
            MaxWidth="1000"
            Margin="16"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,24"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Settings" />

            <TextBlock
                Margin="0,0,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="General" />

            <toolkit:SettingsCard Description="The page Totoro opens on when it starts." Header="Startup page">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE80F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.StartupPages, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.StartupPage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="navigation:NavigationItemViewModel">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Where your anime list and anime details come from. Pages pick up a change the next time they're opened." Header="Anime database">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8F1;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.AnimeDatabases, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.AnimeDatabase, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AnimeDatabaseOption">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <TextBlock
                Margin="0,24,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Accounts" />

            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Accounts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountViewModel">
                        <toolkit:SettingsCard Description="{x:Bind Status, Mode=OneWay}" Header="{x:Bind Name}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE77B;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button
                                MinWidth="120"
                                AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                                Command="{x:Bind SignInOrOutCommand}"
                                Content="{x:Bind ActionText, Mode=OneWay}" />
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <toolkit:SettingsCard Description="When you're signed in to both AniList and MyAnimeList, changes to your list (watching an episode, editing an entry, removing an anime) are made on both. Your main list is the anime database's." Header="Keep my other lists in sync">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SyncOtherLists, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock
                Margin="0,24,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Playback" />

            <toolkit:SettingsCard Description="Where episodes play. The built-in player offers skipping the opening and the next episode over the video; mpv is an app of its own, with its own settings and shaders." Header="Media player">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE714;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.MediaPlayers}"
                    SelectedItem="{x:Bind ViewModel.MediaPlayer, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaPlayerOption">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="When an opening or recap starts. Offering to skip shows a Skip button over the video in the built-in player, and a hint to press Page Up (next chapter) in mpv." Header="Openings">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE893;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.SkipModes}"
                    SelectedItem="{x:Bind ViewModel.OpeningSkip, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkipModeOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="When the ending starts." Header="Endings">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE893;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.SkipModes}"
                    SelectedItem="{x:Bind ViewModel.EndingSkip, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkipModeOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="When you finish an episode, start the next one after a short countdown. Otherwise it's offered." Header="Play the next episode automatically">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE768;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.PlayNextAutomatically, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenEpisodeNumberingCommand}"
                Description="For providers that use absolute numbering, carrying on across seasons (a 2nd season from 13). Rules from anime-relations, and your own."
                Header="Episode numbering"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AB;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock
                Margin="0,24,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Modules" />

            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleSettingsItem">
                        <toolkit:SettingsCard
                            AutomationProperties.Name="{x:Bind Name}"
                            Command="{x:Bind EditCommand}"
                            Description="{x:Bind Summary}"
                            Header="{x:Bind Name}"
                            IsClickEnabled="True">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE74C;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Margin="0,24,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Appearance" />

            <toolkit:SettingsCard Description="Light, dark, or follow your Windows setting." Header="App theme">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.Themes}"
                    SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="The material behind the window: Mica and Mica Alt tint it with your desktop wallpaper, Acrylic blurs what's behind it." Header="Backdrop">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.Backdrops}"
                    SelectedItem="{x:Bind ViewModel.Backdrop, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackdropOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
