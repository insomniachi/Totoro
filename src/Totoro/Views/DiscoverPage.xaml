<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:overlays="using:Totoro.UI.Controls.MediaCardOverlays"
    xmlns:text="using:Totoro.UI.Text"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:toolkitui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Same card actions as the search page; each Command receives the card's AnimeModel  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Play}"
                Label="Play"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.BingeCommand}"
                Icon="{toolkitui:FontIconSource Glyph=&#xE8B2;}"
                Label="Binge" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit tracking"
                OffListIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                OffListLabel="Add to list"
                ShowOnHover="True" />
        </overlays:CardActionCollection>

        <overlays:BrowseOverlays x:Key="CardOverlays" />
        <overlays:UpcomingOverlays x:Key="UpcomingCardOverlays" />

        <DataTemplate x:Key="CardTemplate" x:DataType="anime:AnimeModel">
            <controls:MediaCard
                Width="190"
                Height="320"
                Media="{x:Bind}"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                Overlays="{StaticResource CardOverlays}">
                <Interactivity:Interaction.Behaviors>
                    <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                    <overlays:HoverEffectsBehavior />
                </Interactivity:Interaction.Behaviors>
            </controls:MediaCard>
        </DataTemplate>

        <!--  Not aired yet: nothing to play or track, only to plan  -->
        <overlays:CardActionCollection x:Key="UpcomingCardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.PlanToWatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Add}"
                Label="Plan to watch"
                ShowOnHover="True" />
        </overlays:CardActionCollection>

        <DataTemplate x:Key="UpcomingCardTemplate" x:DataType="anime:AnimeModel">
            <controls:MediaCard
                Width="190"
                Height="320"
                Media="{x:Bind}"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                Overlays="{StaticResource UpcomingCardOverlays}">
                <Interactivity:Interaction.Behaviors>
                    <overlays:ActionsOverlay Actions="{StaticResource UpcomingCardActions}" />
                    <overlays:HoverEffectsBehavior />
                </Interactivity:Interaction.Behaviors>
            </controls:MediaCard>
        </DataTemplate>

        <Style x:Key="RowScrollViewStyle" TargetType="ScrollView">
            <Setter Property="ContentOrientation" Value="Horizontal" />
            <Setter Property="VerticalScrollMode" Value="Disabled" />
            <!--  Still scrolls (wheel, touch); the header's buttons page through it instead of a bar  -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <!--  Out by the cards' margin, so they line up with the headers  -->
            <Setter Property="Margin" Value="-8" />
        </Style>

        <!--  Room for a hovered card to grow (HoverEffectsBehavior) inside its row, which clips what's outside it  -->
        <Style TargetType="ItemsRepeater">
            <Setter Property="Margin" Value="8" />
        </Style>

        <Style
            x:Key="RowHeaderStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="RowPageButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollView>
        <!--
            While it loads, every part of the page shows (see RowVisibility), as placeholders in its place: each row
            placeholder cards from its card template
        -->
        <controls:ShimmerView IsLoading="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
        <StackPanel Padding="16" Spacing="12">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind helpers:CommonConverters.IsAny(ViewModel.Error), Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  Spotlight: trending anime with their banners, turning over by themselves (see the code-behind); one block while loading  -->
            <FlipView
                x:Name="Spotlight"
                Height="380"
                controls:ShimmerView.Shape="Rectangle"
                AutomationProperties.Name="Spotlight"
                CornerRadius="8"
                ItemsSource="{x:Bind ViewModel.Spotlight, Mode=OneWay}"
                Visibility="{x:Bind local:DiscoverPage.RowVisibility(ViewModel.Spotlight, ViewModel.IsBusy), Mode=OneWay}">
                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="anime:AnimeModel">
                        <!--  Dark whatever the app's theme: light text over the darkened banner  -->
                        <Grid RequestedTheme="Dark">
                            <Image Source="{x:Bind BannerImage, Mode=OneTime}" Stretch="UniformToFill" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#F2000000" />
                                        <GradientStop Offset="0.5" Color="#B3000000" />
                                        <GradientStop Offset="1" Color="#1A000000" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid
                                MaxWidth="900"
                                Padding="48,32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="190"
                                    Height="270"
                                    VerticalAlignment="Center"
                                    CornerRadius="8">
                                    <Image Source="{x:Bind Image, Mode=OneTime}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind local:DiscoverPage.Details(Genres, MeanScore, TotalEpisodes, Season), Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <RichTextBlock
                                        MaxLines="4"
                                        text:HtmlText.Html="{x:Bind Description, Mode=OneTime}"
                                        TextTrimming="WordEllipsis" />
                                    <StackPanel
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="Details"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="Play" />
                                        <Button
                                            Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="{x:Bind local:DiscoverPage.TrackingButtonText(Tracking), Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>
            <PipsPager
                HorizontalAlignment="Center"
                NumberOfPages="{x:Bind ViewModel.Spotlight.Count, Mode=OneWay}"
                SelectedPageIndex="{x:Bind Spotlight.SelectedIndex, Mode=TwoWay}"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Spotlight), Mode=OneWay}" />

            <!--  Each row: a header with buttons paging it a screenful at a time (OnPreviousPage/OnNextPage take the row as Tag)  -->
            <StackPanel
                Margin="0,12,0,0"
                Spacing="12"
                Visibility="{x:Bind local:DiscoverPage.RowVisibility(ViewModel.Trending, ViewModel.IsBusy), Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeaderStyle}" Text="Trending now" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Previous trending anime"
                        x:Name="TrendingPrevious"
                        Click="OnPreviousPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind TrendingRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Previous" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Next trending anime"
                        x:Name="TrendingNext"
                        Click="OnNextPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind TrendingRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Next" />
                </Grid>
                <ScrollView
                    x:Name="TrendingRow"
                    ExtentChanged="OnRowChanged"
                    ScrollAnimationStarting="OnRowScrollAnimationStarting"
                    SizeChanged="OnRowChanged"
                    Style="{StaticResource RowScrollViewStyle}"
                    ViewChanged="OnRowChanged">
                    <ItemsRepeater
                        controls:ShimmerView.FillView="True"
                        controls:ShimmerView.PlaceholderCount="4"
                        controls:ShimmerView.PlaceholderItem="{x:Bind local:MediaListView.PlaceholderCard}"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind ViewModel.Trending, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="16" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollView>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind local:DiscoverPage.RowVisibility(ViewModel.AiringToday, ViewModel.IsBusy), Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeaderStyle}" Text="Airing today" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Previous anime airing today"
                        x:Name="AiringTodayPrevious"
                        Click="OnPreviousPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind AiringTodayRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Previous" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Next anime airing today"
                        x:Name="AiringTodayNext"
                        Click="OnNextPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind AiringTodayRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Next" />
                </Grid>
                <ScrollView
                    x:Name="AiringTodayRow"
                    ExtentChanged="OnRowChanged"
                    ScrollAnimationStarting="OnRowScrollAnimationStarting"
                    SizeChanged="OnRowChanged"
                    Style="{StaticResource RowScrollViewStyle}"
                    ViewChanged="OnRowChanged">
                    <ItemsRepeater
                        controls:ShimmerView.FillView="True"
                        controls:ShimmerView.PlaceholderCount="4"
                        controls:ShimmerView.PlaceholderItem="{x:Bind local:MediaListView.PlaceholderCard}"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind ViewModel.AiringToday, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="16" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollView>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind local:DiscoverPage.RowVisibility(ViewModel.NextSeason, ViewModel.IsBusy), Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeaderStyle}" Text="{x:Bind ViewModel.NextSeasonTitle, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Previous anime of next season"
                        x:Name="NextSeasonPrevious"
                        Click="OnPreviousPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind NextSeasonRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Previous" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Next anime of next season"
                        x:Name="NextSeasonNext"
                        Click="OnNextPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind NextSeasonRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Next" />
                </Grid>
                <ScrollView
                    x:Name="NextSeasonRow"
                    ExtentChanged="OnRowChanged"
                    ScrollAnimationStarting="OnRowScrollAnimationStarting"
                    SizeChanged="OnRowChanged"
                    Style="{StaticResource RowScrollViewStyle}"
                    ViewChanged="OnRowChanged">
                    <ItemsRepeater
                        controls:ShimmerView.FillView="True"
                        controls:ShimmerView.PlaceholderCount="4"
                        controls:ShimmerView.PlaceholderItem="{x:Bind local:MediaListView.PlaceholderCard}"
                        ItemTemplate="{StaticResource UpcomingCardTemplate}"
                        ItemsSource="{x:Bind ViewModel.NextSeason, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="16" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollView>
            </StackPanel>

            <!--
                Sequels and spin-offs of what the user watched, not on their list: the first few; See all has the rest.
                It takes far longer than the rest, so it has its own placeholders, to show it's coming rather than pop in later.
            -->
            <controls:ShimmerView IsLoading="{x:Bind ViewModel.IsLoadingMissed, Mode=OneWay}">
            <StackPanel Spacing="12" Visibility="{x:Bind local:DiscoverPage.RowVisibility(ViewModel.Missed, ViewModel.IsLoadingMissed), Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHeaderStyle}" Text="Sequels &amp; spin-offs you missed" />
                    <HyperlinkButton
                        Grid.Column="1"
                        AutomationProperties.Name="See all missed sequels and spin-offs"
                        Command="{x:Bind ViewModel.SeeAllMissedCommand}"
                        Content="See all" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Previous missed anime"
                        x:Name="MissedPrevious"
                        Click="OnPreviousPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind MissedRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Previous" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Next missed anime"
                        x:Name="MissedNext"
                        Click="OnNextPage"
                        Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                        Style="{StaticResource RowPageButtonStyle}"
                        Tag="{x:Bind MissedRow, Mode=OneTime}"
                        ToolTipService.ToolTip="Next" />
                </Grid>
                <ScrollView
                    x:Name="MissedRow"
                    ExtentChanged="OnRowChanged"
                    ScrollAnimationStarting="OnRowScrollAnimationStarting"
                    SizeChanged="OnRowChanged"
                    Style="{StaticResource RowScrollViewStyle}"
                    ViewChanged="OnRowChanged">
                    <ItemsRepeater
                        controls:ShimmerView.FillView="True"
                        controls:ShimmerView.PlaceholderCount="4"
                        controls:ShimmerView.PlaceholderItem="{x:Bind local:MediaListView.PlaceholderCard}"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind ViewModel.Missed, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="16" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollView>
            </StackPanel>
            </controls:ShimmerView>
        </StackPanel>
        </controls:ShimmerView>
    </ScrollView>
</Page>
