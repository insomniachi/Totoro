<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:overlays="using:Totoro.UI.Controls.AnimeCardOverlays"
    xmlns:text="using:Totoro.UI.Text"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:toolkitui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Same card actions as the search page; each Command receives the card's AnimeModel  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Play}"
                Label="Play"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit tracking"
                OffListIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                OffListLabel="Add to list"
                ShowOnHover="True" />
        </overlays:CardActionCollection>

        <DataTemplate x:Key="CardTemplate" x:DataType="anime:AnimeModel">
            <controls:AnimeCard
                Width="190"
                Height="320"
                Anime="{x:Bind}"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}">
                <Interactivity:Interaction.Behaviors>
                    <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                    <overlays:ListStatusOverlay />
                    <overlays:MeanScoreOverlay />
                    <overlays:HoverEffectsBehavior />
                </Interactivity:Interaction.Behaviors>
            </controls:AnimeCard>
        </DataTemplate>

        <!--  Not aired yet: nothing to play or track, only to plan  -->
        <overlays:CardActionCollection x:Key="UpcomingCardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.PlanToWatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Add}"
                Label="Plan to watch"
                ShowOnHover="True" />
        </overlays:CardActionCollection>

        <DataTemplate x:Key="UpcomingCardTemplate" x:DataType="anime:AnimeModel">
            <controls:AnimeCard
                Width="190"
                Height="320"
                Anime="{x:Bind}"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}">
                <Interactivity:Interaction.Behaviors>
                    <overlays:ActionsOverlay Actions="{StaticResource UpcomingCardActions}" />
                    <overlays:ListStatusOverlay />
                    <overlays:HoverEffectsBehavior />
                </Interactivity:Interaction.Behaviors>
            </controls:AnimeCard>
        </DataTemplate>

        <Style x:Key="RowScrollViewStyle" TargetType="ScrollView">
            <Setter Property="ContentOrientation" Value="Horizontal" />
            <Setter Property="VerticalScrollMode" Value="Disabled" />
            <!--  Still scrolls (wheel, touch); the header's buttons page through it instead of a bar  -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <!--  Out by the cards' margin, so they line up with the headers  -->
            <Setter Property="Margin" Value="-8" />
        </Style>

        <!--  Room for a hovered card to grow (HoverEffectsBehavior) inside its row, which clips what's outside it  -->
        <Style TargetType="ItemsRepeater">
            <Setter Property="Margin" Value="8" />
        </Style>

        <Style
            x:Key="RowHeaderStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="RowPageButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollView>
            <StackPanel Padding="16" Spacing="12">

                <!--  Spotlight: trending anime with their banners, turning over by themselves (see the code-behind)  -->
                <FlipView
                    x:Name="Spotlight"
                    Height="380"
                    AutomationProperties.Name="Spotlight"
                    CornerRadius="8"
                    ItemsSource="{x:Bind ViewModel.Spotlight, Mode=OneWay}"
                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Spotlight), Mode=OneWay}">
                    <FlipView.ItemTemplate>
                        <DataTemplate x:DataType="anime:AnimeModel">
                            <!--  Dark whatever the app's theme: light text over the darkened banner  -->
                            <Grid RequestedTheme="Dark">
                                <Image Source="{x:Bind BannerImage}" Stretch="UniformToFill" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#F2000000" />
                                            <GradientStop Offset="0.5" Color="#B3000000" />
                                            <GradientStop Offset="1" Color="#1A000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Grid
                                    MaxWidth="900"
                                    Padding="48,32"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="190"
                                        Height="270"
                                        VerticalAlignment="Center"
                                        CornerRadius="8">
                                        <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource TitleTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind local:DiscoverPage.Details(Genres, MeanScore, TotalEpisodes, Season)}"
                                            TextTrimming="CharacterEllipsis" />
                                        <RichTextBlock
                                            MaxLines="4"
                                            text:HtmlText.Html="{x:Bind Description}"
                                            TextTrimming="WordEllipsis" />
                                        <StackPanel
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}"
                                                CommandParameter="{x:Bind}"
                                                Content="Details"
                                                Style="{StaticResource AccentButtonStyle}" />
                                            <Button
                                                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                                                CommandParameter="{x:Bind}"
                                                Content="Play" />
                                            <Button
                                                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                                                CommandParameter="{x:Bind}"
                                                Content="{x:Bind local:DiscoverPage.TrackingButtonText(Tracking), Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </FlipView.ItemTemplate>
                </FlipView>
                <PipsPager
                    HorizontalAlignment="Center"
                    NumberOfPages="{x:Bind ViewModel.Spotlight.Count, Mode=OneWay}"
                    SelectedPageIndex="{x:Bind Spotlight.SelectedIndex, Mode=TwoWay}"
                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Spotlight), Mode=OneWay}" />

                <!--  Each row: a header with buttons paging it a screenful at a time (OnPreviousPage/OnNextPage take the row as Tag)  -->
                <StackPanel
                    Margin="0,12,0,0"
                    Spacing="12"
                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Trending), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowHeaderStyle}" Text="Trending now" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Previous trending anime"
                            x:Name="TrendingPrevious"
                            Click="OnPreviousPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind TrendingRow}"
                            ToolTipService.ToolTip="Previous" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Next trending anime"
                            x:Name="TrendingNext"
                            Click="OnNextPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind TrendingRow}"
                            ToolTipService.ToolTip="Next" />
                    </Grid>
                    <ScrollView
                        x:Name="TrendingRow"
                        ExtentChanged="OnRowChanged"
                        ScrollAnimationStarting="OnRowScrollAnimationStarting"
                        SizeChanged="OnRowChanged"
                        Style="{StaticResource RowScrollViewStyle}"
                        ViewChanged="OnRowChanged">
                        <ItemsRepeater ItemTemplate="{StaticResource CardTemplate}" ItemsSource="{x:Bind ViewModel.Trending, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>
                </StackPanel>

                <!--  Sequels and spin-offs of what the user watched, not on their list: the first few; See all has the rest  -->
                <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Missed), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowHeaderStyle}" Text="Sequels &amp; spin-offs you missed" />
                        <HyperlinkButton
                            Grid.Column="1"
                            AutomationProperties.Name="See all missed sequels and spin-offs"
                            Command="{x:Bind ViewModel.SeeAllMissedCommand}"
                            Content="See all" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Previous missed anime"
                            x:Name="MissedPrevious"
                            Click="OnPreviousPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind MissedRow}"
                            ToolTipService.ToolTip="Previous" />
                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="Next missed anime"
                            x:Name="MissedNext"
                            Click="OnNextPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind MissedRow}"
                            ToolTipService.ToolTip="Next" />
                    </Grid>
                    <ScrollView
                        x:Name="MissedRow"
                        ExtentChanged="OnRowChanged"
                        ScrollAnimationStarting="OnRowScrollAnimationStarting"
                        SizeChanged="OnRowChanged"
                        Style="{StaticResource RowScrollViewStyle}"
                        ViewChanged="OnRowChanged">
                        <ItemsRepeater ItemTemplate="{StaticResource CardTemplate}" ItemsSource="{x:Bind ViewModel.Missed, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.AiringToday), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowHeaderStyle}" Text="Airing today" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Previous anime airing today"
                            x:Name="AiringTodayPrevious"
                            Click="OnPreviousPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind AiringTodayRow}"
                            ToolTipService.ToolTip="Previous" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Next anime airing today"
                            x:Name="AiringTodayNext"
                            Click="OnNextPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind AiringTodayRow}"
                            ToolTipService.ToolTip="Next" />
                    </Grid>
                    <ScrollView
                        x:Name="AiringTodayRow"
                        ExtentChanged="OnRowChanged"
                        ScrollAnimationStarting="OnRowScrollAnimationStarting"
                        SizeChanged="OnRowChanged"
                        Style="{StaticResource RowScrollViewStyle}"
                        ViewChanged="OnRowChanged">
                        <ItemsRepeater ItemTemplate="{StaticResource CardTemplate}" ItemsSource="{x:Bind ViewModel.AiringToday, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.NextSeason), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowHeaderStyle}" Text="{x:Bind ViewModel.NextSeasonTitle, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Previous anime of next season"
                            x:Name="NextSeasonPrevious"
                            Click="OnPreviousPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76B;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind NextSeasonRow}"
                            ToolTipService.ToolTip="Previous" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Next anime of next season"
                            x:Name="NextSeasonNext"
                            Click="OnNextPage"
                            Content="{toolkitui:FontIcon Glyph=&#xE76C;, FontSize=14}"
                            Style="{StaticResource RowPageButtonStyle}"
                            Tag="{x:Bind NextSeasonRow}"
                            ToolTipService.ToolTip="Next" />
                    </Grid>
                    <ScrollView
                        x:Name="NextSeasonRow"
                        ExtentChanged="OnRowChanged"
                        ScrollAnimationStarting="OnRowScrollAnimationStarting"
                        SizeChanged="OnRowChanged"
                        Style="{StaticResource RowScrollViewStyle}"
                        ViewChanged="OnRowChanged">
                        <ItemsRepeater ItemTemplate="{StaticResource UpcomingCardTemplate}" ItemsSource="{x:Bind ViewModel.NextSeason, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>
                </StackPanel>
            </StackPanel>
        </ScrollView>

        <ProgressRing
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
