<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.AnimeDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:details="using:Totoro.Views.AnimeDetails"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">


    <Grid>
        <!--
            Hidden until everything has loaded, details and images alike (see the code-behind), so it appears all at once.
            Opacity rather than Visibility: a collapsed Image never loads, so it would never report being ready.
        -->
        <ScrollView
            x:Name="DetailsContent"
            IsHitTestVisible="False"
            Opacity="0">
            <StackPanel Padding="0,0,0,32" Spacing="24">

                <!--  Header: banner fading into the page, with the cover and title over it  -->
                <Grid Height="320">
                    <Image
                        x:Name="BannerImageElement"
                        VerticalAlignment="Center"
                        ImageFailed="OnImageDone"
                        ImageOpened="OnImageDone"
                        Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.BannerImage), Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <!--  Fades the banner into the page; reaches the page colour just before the bottom and overhangs by
                          a pixel, so the banner's antialiased bottom row doesn't show as a line  -->
                    <Rectangle Margin="0,0,0,-1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.3" Color="Transparent" />
                                <GradientStop Offset="0.95" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid
                        Padding="24,0"
                        VerticalAlignment="Bottom"
                        ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="170"
                            Height="240"
                            CornerRadius="8">
                            <Image
                                x:Name="CoverImageElement"
                                ImageFailed="OnImageDone"
                                ImageOpened="OnImageDone"
                                Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.CoverImage), Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                            <TextBlock
                                MaxLines="3"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Subtitle), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!--  Tab keys must match AnimeDetailsViewModel's *Tab constants  -->
                <SelectorBar
                    x:Name="Tabs"
                    Margin="16,-8,16,0"
                    SelectionChanged="OnTabSelectionChanged">
                    <SelectorBarItem
                        IsSelected="True"
                        Tag="Overview"
                        Text="Overview" />
                    <SelectorBarItem Tag="Episodes" Text="Episodes" />
                    <SelectorBarItem Tag="Characters" Text="Characters" />
                    <SelectorBarItem Tag="Music" Text="Music" />
                    <SelectorBarItem Tag="Related" Text="Related" />
                </SelectorBar>

                <toolkit:SwitchPresenter Value="{x:Bind ViewModel.SelectedTab, Mode=OneWay}">
                    <toolkit:Case Value="Overview">
                        <details:OverviewTabView ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Episodes">
                        <details:EpisodesTabView ViewModel="{x:Bind ViewModel.Episodes, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Characters">
                        <details:CharactersTabView ViewModel="{x:Bind ViewModel.Characters, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Music">
                        <details:MusicTabView ViewModel="{x:Bind ViewModel.Music, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Related">
                        <details:RelatedTabView ViewModel="{x:Bind ViewModel.Related, Mode=OneWay}" />
                    </toolkit:Case>
                </toolkit:SwitchPresenter>
            </StackPanel>
        </ScrollView>

        <!--  Shown until the content is revealed; mirrors the page's layout so the switch keeps the same shapes  -->
        <StackPanel
            x:Name="LoadingSkeleton"
            IsHitTestVisible="False"
            Spacing="24">
            <Grid Height="320">
                <toolkit:Shimmer CornerRadius="0" />
                <!--  Same fade as the real banner, so the poster and title placeholders stand out from it  -->
                <Rectangle Margin="0,0,0,-1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent" />
                            <GradientStop Offset="0.95" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid
                    Padding="24,0"
                    VerticalAlignment="Bottom"
                    ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  On a page-coloured background, so it looks like the other placeholders rather than the banner's  -->
                    <Border
                        Width="170"
                        Height="240"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="8">
                        <toolkit:Shimmer CornerRadius="8" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                        <toolkit:Shimmer
                            Width="320"
                            Height="24"
                            HorizontalAlignment="Left"
                            CornerRadius="4" />
                        <toolkit:Shimmer
                            Width="200"
                            Height="16"
                            HorizontalAlignment="Left"
                            CornerRadius="4" />
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Padding="24,0" Spacing="24">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <toolkit:Shimmer Width="44" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="72" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="88" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="56" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="96" Height="24" CornerRadius="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <toolkit:Shimmer Width="80" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="64" Height="24" CornerRadius="12" />
                        <toolkit:Shimmer Width="76" Height="24" CornerRadius="12" />
                    </StackPanel>
                </StackPanel>

                <toolkit:Shimmer Height="76" CornerRadius="8" />

                <StackPanel Spacing="8">
                    <toolkit:Shimmer
                        Width="90"
                        Height="16"
                        HorizontalAlignment="Left"
                        CornerRadius="4" />
                    <toolkit:Shimmer Height="14" CornerRadius="4" />
                    <toolkit:Shimmer Height="14" CornerRadius="4" />
                    <toolkit:Shimmer Height="14" CornerRadius="4" />
                    <toolkit:Shimmer
                        Width="360"
                        Height="14"
                        HorizontalAlignment="Left"
                        CornerRadius="4" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
