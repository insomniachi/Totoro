<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.AnimeDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:details="using:Totoro.Views.AnimeDetails"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Totoro.UI.Controls"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">


    <!--
        Placeholders mirroring the page until everything has loaded, details and images alike (see the code-behind), so it
        appears all at once. The content stays in the tree meanwhile, hidden, so its images load.
    -->
    <ui:ShimmerView x:Name="LoadingShimmer">
        <ScrollView>
            <StackPanel Padding="0,0,0,32" Spacing="24">

                <!--  Header: banner fading into the page, with the cover and title over it  -->
                <Grid Height="320">
                    <!--  No placeholder: the cover's and title's stand out on the plain page, rather than doubling up over one  -->
                    <Image
                        x:Name="BannerImageElement"
                        VerticalAlignment="Center"
                        ui:ShimmerView.Ignore="True"
                        ImageFailed="OnImageDone"
                        ImageOpened="OnImageDone"
                        Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.BannerImage), Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <!--  Fades the banner into the page; reaches the page colour just before the bottom and overhangs by
                          a pixel, so the banner's antialiased bottom row doesn't show as a line  -->
                    <Rectangle Margin="0,0,0,-1" ui:ShimmerView.Ignore="True">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.3" Color="Transparent" />
                                <GradientStop Offset="0.95" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid
                        Padding="24,0"
                        VerticalAlignment="Bottom"
                        ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="170"
                            Height="240"
                            CornerRadius="8">
                            <Image
                                x:Name="CoverImageElement"
                                ImageFailed="OnImageDone"
                                ImageOpened="OnImageDone"
                                Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.CoverImage), Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                            <!--  Left with a least width, so their placeholders are title-like lines rather than the column's width  -->
                            <TextBlock
                                MinWidth="320"
                                HorizontalAlignment="Left"
                                MaxLines="3"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                MinWidth="200"
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Subtitle), Mode=OneWay}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  Still coming out: a dot, in the system's "success" green  -->
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.IsAiring), Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="260"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Facts, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!--  Tab keys must match AnimeDetailsViewModel's *Tab constants. Shown while loading: they don't wait on anything.  -->
                <SelectorBar
                    x:Name="Tabs"
                    Margin="16,-8,16,0"
                    ui:ShimmerView.Ignore="True"
                    SelectionChanged="OnTabSelectionChanged">
                    <SelectorBarItem
                        IsSelected="True"
                        Tag="Overview"
                        Text="Overview" />
                    <SelectorBarItem Tag="Episodes" Text="Episodes" />
                    <SelectorBarItem Tag="Characters" Text="Characters" />
                    <SelectorBarItem Tag="Music" Text="Music" />
                    <SelectorBarItem Tag="Related" Text="Related" />
                </SelectorBar>

                <toolkit:SwitchPresenter Value="{x:Bind ViewModel.SelectedTab, Mode=OneWay}">
                    <toolkit:Case Value="Overview">
                        <details:OverviewTabView ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Episodes">
                        <details:EpisodesTabView ViewModel="{x:Bind ViewModel.Episodes, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Characters">
                        <details:CharactersTabView ViewModel="{x:Bind ViewModel.Characters, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Music">
                        <details:MusicTabView ViewModel="{x:Bind ViewModel.Music, Mode=OneWay}" />
                    </toolkit:Case>
                    <toolkit:Case Value="Related">
                        <details:RelatedTabView ViewModel="{x:Bind ViewModel.Related, Mode=OneWay}" />
                    </toolkit:Case>
                </toolkit:SwitchPresenter>
            </StackPanel>
        </ScrollView>
    </ui:ShimmerView>
</Page>
