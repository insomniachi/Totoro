<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:navigation="using:Totoro.Core.Navigation"
    xmlns:settings="using:Totoro.Views.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <ScrollView>
        <StackPanel
            MaxWidth="1000"
            Margin="16"
            Spacing="4">
            <settings:SettingsHeader Title="About &amp; updates" />

            <!--  Updating from GitHub releases (see UpdateService)  -->
            <toolkit:SettingsCard Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" Header="Updates">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.Updates.CheckCommand}" Content="Check for updates" />
                    <Button
                        Command="{x:Bind ViewModel.Updates.InstallCommand}"
                        Content="Update"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanUpdate, Mode=OneWay}" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Look for a newer version on GitHub when Totoro starts, and offer it." Header="Check for updates when Totoro starts">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
