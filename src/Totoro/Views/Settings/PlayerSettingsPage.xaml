<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Settings.PlayerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:settings="using:Totoro.Views.Settings">

    <ScrollView>
        <StackPanel
            MaxWidth="1000"
            Margin="16"
            Spacing="4">
            <settings:SettingsHeader Title="Player" />
            <controls:DataContainerEditor ShortcutDialogs="True" Properties="{x:Bind ViewModel.PlayerSettings, Mode=OneWay}" />
        </StackPanel>
    </ScrollView>
</Page>
