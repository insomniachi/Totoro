<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Settings.PlaybackSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:navigation="using:Totoro.Core.Navigation"
    xmlns:settings="using:Totoro.Views.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <ScrollView>
        <StackPanel
            MaxWidth="1000"
            Margin="16"
            Spacing="4">
            <settings:SettingsHeader Title="Playback" />

            <TextBlock
                Margin="0,0,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Episodes" />

            <toolkit:SettingsCard Description="Where episodes are found. Downloads plays the episodes you've downloaded; providers to stream from come as plugins. An anime can use another one in its own settings." Header="Anime provider">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA86;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Grid>
                    <ComboBox
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.AnimeProviders}"
                        SelectedItem="{x:Bind ViewModel.AnimeProvider, Mode=TwoWay}"
                        Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.HasAnimeProviders)}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnimeProviderOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="{x:Bind helpers:CommonConverters.ToImageSource(Icon)}" />
                                    <TextBlock Text="{x:Bind Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!--  None installed yet (a fresh install): where to get one  -->
                    <Button
                        MinWidth="120"
                        Command="{x:Bind ViewModel.OpenPluginsCommand}"
                        Content="Get one from Plugins"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind helpers:CommonConverters.InvertedBooleanToVisibility(ViewModel.HasAnimeProviders)}" />
                </Grid>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Where episodes play. The built-in player offers skipping the opening and the next episode over the video; mpv is an app of its own, with its own settings and shaders." Header="Media player">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE714;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.MediaPlayers}"
                    SelectedItem="{x:Bind ViewModel.MediaPlayer, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaPlayerOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{x:Bind helpers:CommonConverters.ToImageSource(Icon)}" />
                                <TextBlock Text="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.OpenEpisodeNumberingCommand}"
                Description="For providers that use absolute numbering, carrying on across seasons (a 2nd season from 13). Rules from anime-relations, and your own."
                Header="Episode numbering"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AB;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock
                Margin="0,24,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="While watching" />

            <toolkit:SettingsCard Description="When an opening or recap starts. Offering to skip shows a Skip button over the video in the built-in player, and a hint to press Page Up (next chapter) in mpv." Header="Openings">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE893;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.SkipModes}"
                    SelectedItem="{x:Bind ViewModel.OpeningSkip, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkipModeOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="When the ending starts." Header="Endings">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE893;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.SkipModes}"
                    SelectedItem="{x:Bind ViewModel.EndingSkip, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkipModeOption">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="When you finish an episode, start the next one after a short countdown. Otherwise it's offered." Header="Play the next episode automatically">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE768;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.PlayNextAutomatically, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="The next episode skips filler (as MyAnimeList marks it). A filler episode you pick yourself still plays." Header="Skip filler episodes">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE893;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SkipFillers, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="While an episode plays, show the anime and episode as your activity on Discord (when Discord is running)." Header="Show what you're watching on Discord">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8BD;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowOnDiscord, Mode=TwoWay}" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
