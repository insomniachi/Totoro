<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.Settings.AccountsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:navigation="using:Totoro.Core.Navigation"
    xmlns:settings="using:Totoro.Views.Settings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <ScrollView>
        <StackPanel
            MaxWidth="1000"
            Margin="16"
            Spacing="4">
            <settings:SettingsHeader Title="Accounts" />

            <toolkit:SettingsCard Description="Where your anime list and anime details come from. Pages pick up a change the next time they're opened." Header="Anime database">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8F1;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.AnimeDatabases, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.AnimeDatabase, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AnimeDatabaseOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{x:Bind helpers:CommonConverters.ToImageSource(Icon)}" />
                                <TextBlock Text="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Where your manga list and manga details come from; it can be another database than the anime one." Header="Manga database">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE736;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    AutomationProperties.Name="Manga database"
                    ItemsSource="{x:Bind ViewModel.MangaDatabases, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.MangaDatabase, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AnimeDatabaseOption">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{x:Bind helpers:CommonConverters.ToImageSource(Icon)}" />
                                <TextBlock Text="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>

            <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Accounts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountViewModel">
                        <toolkit:SettingsCard
                            Description="{x:Bind Status, Mode=OneWay}"
                            Header="{x:Bind Name}"
                            HeaderIcon="{x:Bind helpers:CommonConverters.ToIcon(Icon, '&#xE77B;')}">
                            <Button
                                MinWidth="120"
                                AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                                Command="{x:Bind SignInOrOutCommand}"
                                Content="{x:Bind ActionText, Mode=OneWay}" />
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <toolkit:SettingsCard Description="When you're signed in to both AniList and MyAnimeList, changes to your list (watching an episode, editing an entry, removing an anime) are made on both. Your main list is the anime database's." Header="Keep my other lists in sync">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.SyncOtherLists, Mode=TwoWay}" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
