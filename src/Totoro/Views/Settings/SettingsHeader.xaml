<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.Settings.SettingsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  "Settings › Playback" at the title's size, like Windows Settings; Settings goes back to the categories  -->
    <BreadcrumbBar
        x:Name="Breadcrumb"
        Margin="0,0,0,24"
        ItemClicked="OnItemClicked">
        <BreadcrumbBar.Resources>
            <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
            <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
            <x:Double x:Key="BreadcrumbBarChevronFontSize">14</x:Double>
        </BreadcrumbBar.Resources>
    </BreadcrumbBar>
</UserControl>
