<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views"
    xmlns:playback="using:Totoro.Playback">

    <!--  Spacing per the Windows guidelines: 16 padding, 12 between content areas, 8 between buttons and from a header to its control.  -->
    <Grid
        MaxWidth="1000"
        Margin="16"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Downloads" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="{x:Bind ViewModel.OpenFolder}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                        <TextBlock Text="Open folder" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Episodes go into a folder for each anime, named with its title. Right-click an episode in an anime's details to download it, or download from the Watch page. The download folder is in Settings."
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Nothing downloaded yet."
            Visibility="{x:Bind local:DownloadsPage.VisibleIfNone(ViewModel.Downloads.Count), Mode=OneWay}" />
        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Downloads}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="playback:DownloadItem">
                    <Grid
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="12"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Source, Mode=OneWay}"
                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Source), Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Message, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                AutomationProperties.Name="Show in folder"
                                Click="{x:Bind ShowInExplorer}"
                                ToolTipService.ToolTip="Show in folder">
                                <FontIcon FontSize="16" Glyph="&#xE838;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Cancel"
                                Click="{x:Bind Cancel}"
                                ToolTipService.ToolTip="Cancel"
                                Visibility="{x:Bind IsActive, Mode=OneWay}">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                        <ProgressBar
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            IsIndeterminate="{x:Bind local:DownloadsPage.IsUnknown(Progress), Mode=OneWay}"
                            Visibility="{x:Bind IsActive, Mode=OneWay}"
                            Value="{x:Bind local:DownloadsPage.Percent(Progress), Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
