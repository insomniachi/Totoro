<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.PluginTesterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:tester="using:Totoro.Views.PluginTester"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <Page.Resources>
        <!--  The test's details: what each stage found, or why it failed  -->
        <Style x:Key="DetailsTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <!--  Laid out like Settings: cards 4 apart, a section's header 4 above its cards and 24 below what's before it  -->
    <ScrollView>
        <StackPanel
            MaxWidth="1000"
            Margin="16"
            Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Plugin tester" />
            <TextBlock
                Margin="0,8,0,24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Checks that anime providers work: each one searches for a show, gets its episodes, and finds video servers for an episode."
                TextWrapping="Wrap" />

            <!--  Collapsed while closed (a closed info bar keeps its margin); open, 24 above the next section like one  -->
            <InfoBar
                Margin="0,0,0,20"
                IsOpen="{x:Bind ViewModel.InfoBarIsOpen, Mode=TwoWay}"
                Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.InfoBarIsOpen), Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}" />

            <TextBlock
                Margin="0,0,0,4"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Test" />
            <!--  A card like a SettingsCard (its fill, stroke and corners), with a surface's 16 padding  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="Show"
                            PlaceholderText="A show's title, e.g. Frieren"
                            Text="{x:Bind ViewModel.ShowTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Header="Provider"
                            ItemsSource="{x:Bind ViewModel.FilterOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedFilterOption, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="2"
                            Header="Timeout (seconds)"
                            Maximum="300"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.TimeoutSeconds, Mode=TwoWay}" />
                        <!--  8 between buttons, per the Windows guidelines  -->
                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                MinWidth="120"
                                Command="{x:Bind ViewModel.RunTestsCommand}"
                                Content="Run tests"
                                IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}" />
                            <Button
                                MinWidth="120"
                                Command="{x:Bind ViewModel.CancelTestsCommand}"
                                Content="Cancel"
                                Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8" Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.IsBusy), Mode=OneWay}">
                        <ProgressBar IsIndeterminate="True" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,4">
                <TextBlock
                    VerticalAlignment="Bottom"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Anime providers" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Reload providers"
                    Command="{x:Bind ViewModel.LoadProvidersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="Reload" />
                    </StackPanel>
                </Button>
            </Grid>

            <toolkit:SettingsCard
                Description="Anime providers come as plugins. Install one, then test it here."
                Header="No anime providers"
                Visibility="{x:Bind helpers:CommonConverters.InvertedBooleanToVisibility(ViewModel.HasProviders), Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA86;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button
                    MinWidth="120"
                    Command="{x:Bind ViewModel.GoToPluginsCommand}"
                    Content="Open Plugins"
                    Style="{ThemeResource AccentButtonStyle}" />
            </toolkit:SettingsCard>

            <ItemsControl
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.HasProviders), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginTestItemViewModel">
                        <toolkit:SettingsExpander
                            Header="{x:Bind Name}"
                            HeaderIcon="{x:Bind helpers:CommonConverters.ToIcon(Icon, '&#xEA86;')}"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <toolkit:SettingsExpander.Description>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Description)}" />
                                    <TextBlock Text="{x:Bind VersionText}" />
                                </StackPanel>
                            </toolkit:SettingsExpander.Description>

                            <!--  The result, and a test of just this provider  -->
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <tester:TestStatusIcon VerticalAlignment="Center" Status="{x:Bind OverallStatus, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind OverallStatusText, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind TotalDurationText, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(TotalDurationText), Mode=OneWay}" />
                                <Button
                                    MinWidth="120"
                                    Margin="4,0,0,0"
                                    Command="{x:Bind RunTestCommand}"
                                    Content="Test" />
                            </StackPanel>

                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard Description="{x:Bind SearchStage.Message, Mode=OneWay}" Header="{x:Bind SearchStage.Name}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SearchStage.DurationText, Mode=OneWay}" />
                                        <tester:TestStatusIcon VerticalAlignment="Center" Status="{x:Bind SearchStage.Status, Mode=OneWay}" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Description="{x:Bind EpisodesStage.Message, Mode=OneWay}" Header="{x:Bind EpisodesStage.Name}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind EpisodesStage.DurationText, Mode=OneWay}" />
                                        <tester:TestStatusIcon VerticalAlignment="Center" Status="{x:Bind EpisodesStage.Status, Mode=OneWay}" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Description="{x:Bind ServersStage.Message, Mode=OneWay}" Header="{x:Bind ServersStage.Name}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ServersStage.DurationText, Mode=OneWay}" />
                                        <tester:TestStatusIcon VerticalAlignment="Center" Status="{x:Bind ServersStage.Status, Mode=OneWay}" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <!--  What went wrong, and what each stage found  -->
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Stretch"
                                    ContentAlignment="Vertical"
                                    Header="Error"
                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(HasError), Mode=OneWay}">
                                    <TextBlock
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource DetailsTextStyle}"
                                        Text="{x:Bind ErrorDetails, Mode=OneWay}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Stretch"
                                    ContentAlignment="Vertical"
                                    Header="Shows found"
                                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ShowsDetails), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource DetailsTextStyle}" Text="{x:Bind ShowsDetails, Mode=OneWay}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Stretch"
                                    ContentAlignment="Vertical"
                                    Header="Episodes found"
                                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(EpisodesDetails), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource DetailsTextStyle}" Text="{x:Bind EpisodesDetails, Mode=OneWay}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Stretch"
                                    ContentAlignment="Vertical"
                                    Header="Video servers found"
                                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ServersDetails), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource DetailsTextStyle}" Text="{x:Bind ServersDetails, Mode=OneWay}" />
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollView>
</Page>
