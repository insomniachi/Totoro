<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.AnimeDetails.RelatedTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="using:Totoro.Commands"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Totoro.UI.Controls"
    xmlns:vm="using:Totoro.ViewModels.AnimeDetails">

    <UserControl.Resources>
        <!--  A related or recommended anime: cover and title; clicking it opens that anime's details  -->
        <DataTemplate x:Key="RelatedAnimeTemplate" x:DataType="vm:RelatedItem">
            <Button
                Width="110"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand, Mode=OneTime}"
                CommandParameter="{x:Bind Anime, Mode=OneTime}">
                <StackPanel Spacing="8">
                    <Border
                        Height="150"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Grid>
                            <!--  Shimmers until the image loads over it; only when there is an image to load  -->
                            <toolkit:Shimmer CornerRadius="8" Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Image), Mode=OneTime}" />
                            <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Image), Mode=OneTime}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <!--  Always two lines tall: UniformGridLayout sizes every item like the first, which would clip others' second line  -->
                    <TextBlock
                        Height="32"
                        MaxLines="2"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneTime}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!--  Related and recommended come with the details; the series is fetched, so it shimmers until then  -->
    <StackPanel Padding="24,0" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}" />
        <ui:ShimmerView IsLoading="{x:Bind helpers:CommonConverters.Not(ViewModel.IsLoaded), Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Series"
                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Series), Mode=OneWay}" />
                <ItemsRepeater
                    ui:ShimmerView.PlaceholderCount="3"
                    ui:ShimmerView.PlaceholderItem="{x:Bind vm:RelatedItem.Placeholder}"
                    ItemTemplate="{StaticResource RelatedAnimeTemplate}"
                    ItemsSource="{x:Bind ViewModel.Series, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            MinColumnSpacing="16"
                            MinItemWidth="110"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ui:ShimmerView>
        <TextBlock
            Margin="0,12,0,0"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Text="Related"
            Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Related), Mode=OneWay}" />
        <ItemsRepeater ItemTemplate="{StaticResource RelatedAnimeTemplate}" ItemsSource="{x:Bind ViewModel.Related, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsJustification="Start"
                    MinColumnSpacing="16"
                    MinItemWidth="110"
                    MinRowSpacing="16" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>
        <TextBlock
            Margin="0,12,0,0"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Text="Recommended"
            Visibility="{x:Bind helpers:CommonConverters.VisibleIfNotEmpty(ViewModel.Recommended), Mode=OneWay}" />
        <ItemsRepeater ItemTemplate="{StaticResource RelatedAnimeTemplate}" ItemsSource="{x:Bind ViewModel.Recommended, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsJustification="Start"
                    MinColumnSpacing="16"
                    MinItemWidth="110"
                    MinRowSpacing="16" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
