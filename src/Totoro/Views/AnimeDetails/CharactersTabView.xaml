<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.AnimeDetails.CharactersTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Totoro.UI.Controls"
    xmlns:vm="using:Totoro.ViewModels.AnimeDetails">

    <!--  Placeholder cards from the ItemTemplate while loading  -->
    <ui:ShimmerView Padding="24,0" IsLoading="{x:Bind helpers:CommonConverters.Not(ViewModel.IsLoaded), Mode=OneWay}">
        <StackPanel Spacing="12">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}" />
            <ItemsRepeater
                ui:ShimmerView.PlaceholderCount="5"
                ui:ShimmerView.PlaceholderItem="{x:Bind vm:CharacterItem.Placeholder}"
                ItemsSource="{x:Bind ViewModel.Characters, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        MinColumnSpacing="16"
                        MinItemWidth="110"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <!--  Clicking one opens the character's page in the side pane, as the Related tab's anime do  -->
                    <DataTemplate x:DataType="vm:CharacterItem">
                        <Button
                            Width="110"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCharacterClick"
                            Tag="{x:Bind Character, Mode=OneTime}">
                            <StackPanel Spacing="8">
                                <Border
                                    Height="150"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <Grid>
                                        <!--  Shimmers until the image loads over it; only when there is an image to load  -->
                                        <toolkit:Shimmer CornerRadius="8" Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Image), Mode=OneTime}" />
                                        <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Image), Mode=OneTime}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    MaxLines="2"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Name, Mode=OneTime}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ui:ShimmerView>
</UserControl>
