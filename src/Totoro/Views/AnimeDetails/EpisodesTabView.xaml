<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.AnimeDetails.EpisodesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="using:Totoro.Commands"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views.AnimeDetails"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:Totoro.UI.Controls"
    xmlns:vm="using:Totoro.ViewModels.AnimeDetails">

    <!--  Mirrors the episode cards as placeholders while loading (three empty rows from the ItemTemplate on first load)  -->
    <ui:ShimmerView Padding="24,0" IsLoading="{x:Bind helpers:CommonConverters.Not(ViewModel.IsLoaded), Mode=OneWay}">
        <StackPanel Spacing="12">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}" />
            <ItemsRepeater
                ui:ShimmerView.PlaceholderCount="3"
                ui:ShimmerView.PlaceholderItem="{x:Bind vm:EpisodeItem.Placeholder}"
                ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:EpisodeItem">
                        <!--  A card per episode, so episodes are easy to tell apart; 12 inside, as between the cards. One placeholder while loading.  -->
                        <Grid
                            Padding="12"
                            ui:ShimmerView.Shape="Rectangle"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  The thumbnail plays the episode (not specials); the bar along its bottom is where it was left off  -->
                            <Button
                                Width="160"
                                Height="90"
                                Padding="0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Bind PlayName, Mode=OneTime}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="0"
                                Command="{x:Bind commands:AnimeCommands.Shared.WatchEpisodeCommand, Mode=OneTime}"
                                CommandParameter="{x:Bind Play, Mode=OneTime}"
                                CornerRadius="8"
                                IsEnabled="{x:Bind CanPlay, Mode=OneTime}"
                                PointerEntered="OnThumbnailPointerEntered"
                                PointerExited="OnThumbnailPointerExited"
                                ToolTipService.ToolTip="{x:Bind PlayName, Mode=OneTime}">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Command="{x:Bind commands:AnimeCommands.Shared.BingeEpisodeCommand, Mode=OneTime}"
                                            CommandParameter="{x:Bind Play, Mode=OneTime}"
                                            IsEnabled="{x:Bind CanPlay, Mode=OneTime}"
                                            Text="Binge">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B2;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Command="{x:Bind commands:AnimeCommands.Shared.DownloadEpisodeCommand, Mode=OneTime}"
                                            CommandParameter="{x:Bind Play, Mode=OneTime}"
                                            Text="Download">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE896;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid>
                                    <!--  Shimmers until the image loads over it; only when there is an image to load  -->
                                    <toolkit:Shimmer CornerRadius="8" Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Image), Mode=OneTime}" />
                                    <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Image), Mode=OneTime}" Stretch="UniformToFill" />
                                    <!--  Grows and fills with the accent colour on hover (see the code-behind)  -->
                                    <Grid
                                        x:Name="PlayBadge"
                                        Width="36"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(CanPlay), Mode=OneTime}">
                                        <Ellipse Fill="{ThemeResource SmokeFillColorDefaultBrush}" />
                                        <Ellipse
                                            x:Name="PlayHighlight"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            Opacity="0" />
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="White"
                                            Glyph="&#xE768;" />
                                    </Grid>
                                    <!--
                                        Drawn rather than a ProgressBar, whose track is a hairline: an inset pill (clear of the
                                        rounded corners) with a light see-through track its full length, so the bar shows over any
                                        image and even a few seconds' progress reads as a bar.
                                    -->
                                    <Grid
                                        Height="4"
                                        Margin="8,0,8,8"
                                        VerticalAlignment="Bottom"
                                        Background="#66FFFFFF"
                                        CornerRadius="2"
                                        Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(HasProgress), Mode=OneTime}">
                                        <Rectangle
                                            Width="{x:Bind local:EpisodesTabView.ProgressWidth(Progress), Mode=OneTime}"
                                            HorizontalAlignment="Left"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                    <!--  A ribbon across the top-left corner in the caution colour, so a filler stands out in the list; clipped to the thumbnail  -->
                                    <Canvas IsHitTestVisible="False" Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsFiller), Mode=OneTime}">
                                        <Canvas.Clip>
                                            <RectangleGeometry Rect="0,0,160,90" />
                                        </Canvas.Clip>
                                        <Border
                                            Canvas.Left="-26"
                                            Canvas.Top="14"
                                            Width="100"
                                            Height="20"
                                            Background="{ThemeResource SystemFillColorCautionBrush}"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-45" />
                                            </Border.RenderTransform>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="FILLER" />
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Number, Mode=OneTime}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <!--  Watched  -->
                                    <FontIcon
                                        Grid.Column="2"
                                        AutomationProperties.Name="Watched"
                                        FontSize="14"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE930;"
                                        Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsWatched), Mode=OneTime}" />
                                </Grid>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{x:Bind Details, Mode=OneTime}" /><Run Text="{x:Bind ResumeSeparator, Mode=OneTime}" /><Run Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind ResumeText, Mode=OneTime}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    MaxLines="3"
                                    Text="{x:Bind Overview, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ui:ShimmerView>
</UserControl>
