<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.AdvancedSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:toolkitui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Totoro.ViewModels"
    xmlns:overlays="using:Totoro.UI.Controls.AnimeCardOverlays"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:NullableNumberConverter x:Key="NullableNumber" />
        <helpers:OptionalBoundConverter x:Key="OptionalBound" />

        <!--  Same card actions as the user list; each Command receives the card's AnimeModel  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Play}"
                Label="Play" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit" />
            <overlays:CardAction Icon="{toolkitui:SymbolIconSource Symbol=Download}" Label="Download" />
        </overlays:CardActionCollection>
    </Page.Resources>

    <!--  16 here plus the results' 16 margin: the same 32 gap as between the cards  -->
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!--  Results: placeholders while searching, then the cards, or why there are none  -->
        <toolkit:SwitchPresenter TargetType="x:Boolean" Value="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <toolkit:Case Value="True">
                <ItemsRepeater Margin="16,8,16,16" ItemsSource="{x:Bind PlaceholderCards}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <toolkit:Shimmer CornerRadius="8" />
                                <toolkit:Shimmer
                                    Grid.Row="1"
                                    Height="20"
                                    Margin="24,0"
                                    CornerRadius="4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="32"
                            MinItemHeight="400"
                            MinItemWidth="250"
                            MinRowSpacing="32" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </toolkit:Case>
            <toolkit:Case IsDefault="True" Value="False">
                <Grid>
                    <ScrollView>
                        <ItemsRepeater Margin="16,8,16,16" ItemsSource="{x:Bind ViewModel.Anime}">
                            <ItemsRepeater.ItemTransitionProvider>
                                <controls:CardCollectionTransitionProvider />
                            </ItemsRepeater.ItemTransitionProvider>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="anime:AnimeModel">
                                    <controls:AnimeCard Anime="{x:Bind}" Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}">
                                        <Interactivity:Interaction.Behaviors>
                                            <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                                            <overlays:NextEpisodeOverlay />
                                            <overlays:NewEpisodesOverlay />
                                            <overlays:AiringStatusOverlay />
                                            <overlays:HoverEffectsBehavior />
                                        </Interactivity:Interaction.Behaviors>
                                    </controls:AnimeCard>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="32"
                                    MinItemHeight="400"
                                    MinItemWidth="250"
                                    MinRowSpacing="32" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}">
                        <FontIcon
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE721;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </toolkit:Case>
        </toolkit:SwitchPresenter>

        <!--
            Filters, on a raised surface so they read as one panel apart from the results (the theme's layer fill, like
            the cards in Settings); they scroll on their own. Any change searches after a short pause.
            Spacing follows the Windows guidelines: 16 from the surface's edge, 12 between fields, 8 to a field's header.
        -->
        <Border
            Grid.Column="1"
            Margin="0,8,16,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollView>
                <StackPanel Padding="16" Spacing="12">
                    <!--  The panel's heading, with clearing every filter at its end  -->
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Filters" />
                        <HyperlinkButton
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Clear all filters"
                            Command="{x:Bind ViewModel.ClearSearchFiltersCommand}"
                            Content="Clear all"
                            ToolTipService.ToolTip="Clear all filters" />
                    </Grid>

                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Header="Database"
                        ItemsSource="{x:Bind ViewModel.Providers}"
                        SelectedItem="{x:Bind ViewModel.Provider, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnimeDatabaseOption">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox
                        Header="Title"
                        PlaceholderText="Any title"
                        Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  As with Sort by: the label is outside the row, so the dropdown and the button line up  -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Season" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Season"
                                ItemsSource="{x:Bind ViewModel.Seasons}"
                                SelectedItem="{x:Bind ViewModel.SelectedSeason, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SeasonOption">
                                        <TextBlock Text="{x:Bind Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!--  Picks the current season and year  -->
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.CurrentSeasonName}"
                                Command="{x:Bind ViewModel.CurrentSeasonCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSeasonName}">
                                <FontIcon FontSize="14" Glyph="&#xE787;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  Any, one year, or a range; a range may be open at either end  -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Year" />
                        <toolkit:Segmented
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Year filter"
                            SelectedIndex="{x:Bind ViewModel.YearModeIndex, Mode=TwoWay}">
                            <toolkit:SegmentedItem Content="Any" />
                            <toolkit:SegmentedItem Content="Year" />
                            <toolkit:SegmentedItem Content="Range" />
                        </toolkit:Segmented>
                        <!--  TargetType converts the cases' names to the enum, to compare them with the value  -->
                        <toolkit:SwitchPresenter TargetType="vm:YearFilterMode" Value="{x:Bind ViewModel.YearMode, Mode=OneWay}">
                            <toolkit:Case Value="Year">
                                <NumberBox
                                    AutomationProperties.Name="Year"
                                    Maximum="{x:Bind ViewModel.CurrentYear}"
                                    Minimum="1940"
                                    PlaceholderText="e.g. 2016"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.Year, Mode=TwoWay, Converter={StaticResource NullableNumber}, ConverterParameter=Int32}" />
                            </toolkit:Case>
                            <toolkit:Case Value="Range">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        AutomationProperties.Name="From year"
                                        Maximum="{x:Bind ViewModel.CurrentYear}"
                                        Minimum="1940"
                                        PlaceholderText="Any"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.MinimumYear, Mode=TwoWay, Converter={StaticResource NullableNumber}, ConverterParameter=Int32}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="to" />
                                    <NumberBox
                                        Grid.Column="2"
                                        AutomationProperties.Name="To year"
                                        Maximum="{x:Bind ViewModel.CurrentYear}"
                                        Minimum="1940"
                                        PlaceholderText="Any"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.MaximumYear, Mode=TwoWay, Converter={StaticResource NullableNumber}, ConverterParameter=Int32}" />
                                </Grid>
                            </toolkit:Case>
                        </toolkit:SwitchPresenter>
                    </StackPanel>

                    <!--  The thumbs at the ends mean no limit on that side  -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Score" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.ScoreRangeText, Mode=OneWay}" />
                        </Grid>
                        <toolkit:RangeSelector
                            AutomationProperties.Name="Score"
                            Maximum="10"
                            Minimum="0"
                            RangeEnd="{x:Bind ViewModel.MaximumScore, Mode=TwoWay, Converter={StaticResource OptionalBound}, ConverterParameter=10}"
                            RangeStart="{x:Bind ViewModel.MinimumScore, Mode=TwoWay, Converter={StaticResource OptionalBound}, ConverterParameter=0}"
                            StepFrequency="0.5" />
                    </StackPanel>

                    <!--  Type to find a genre; the suggestions only offer genres the database knows (see the code-behind)  -->
                    <toolkit:TokenizingTextBox
                        x:Name="IncludedGenresBox"
                        Header="With genres"
                        ItemsSource="{x:Bind ViewModel.IncludedGenres}"
                        PlaceholderText="Add a genre"
                        QueryIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                        TextChanged="OnGenreTextChanged"
                        TokenItemAdding="OnGenreAdding" />
                    <toolkit:TokenizingTextBox
                        x:Name="ExcludedGenresBox"
                        Header="Without genres"
                        ItemsSource="{x:Bind ViewModel.ExcludedGenres}"
                        PlaceholderText="Add a genre"
                        QueryIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                        TextChanged="OnGenreTextChanged"
                        TokenItemAdding="OnGenreAdding" />

                    <!--  The label is outside the row so the dropdown and the order button line up at the same height  -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sort by" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Sort by"
                                ItemsSource="{x:Bind ViewModel.SortOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SortOption">
                                        <TextBlock Text="{x:Bind Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!--  Shows the current order; clicking reverses it  -->
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind local:AdvancedSearchPage.SortOrderName(ViewModel.SortOrderText), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleSortOrderCommand}"
                                ToolTipService.ToolTip="{x:Bind local:AdvancedSearchPage.SortOrderName(ViewModel.SortOrderText), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="{x:Bind local:AdvancedSearchPage.SortOrderGlyph(ViewModel.IsAscending), Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollView>
        </Border>
    </Grid>
</Page>
