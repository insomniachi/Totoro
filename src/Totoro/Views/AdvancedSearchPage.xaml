<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.AdvancedSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Totoro.Views">

    <!--  Ctrl+V with an image anywhere on the page searches with it, on the Image tab  -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Invoked="OnPasteInvoked"
            Key="V"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  By title and filters, or by a screenshot; the Paste image button only on the latter  -->
        <Grid Margin="16,8,16,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="Tabs"
                AutomationProperties.Name="Search by"
                SelectionChanged="OnTabChanged">
                <SelectorBarItem
                    x:Name="TitleTab"
                    AutomationProperties.AutomationId="TitleTab"
                    IsSelected="True"
                    Text="Title &amp; filters" />
                <SelectorBarItem
                    x:Name="ImageTab"
                    AutomationProperties.AutomationId="ImageTab"
                    Text="Image" />
            </SelectorBar>
            <Button
                x:Name="PasteButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PasteImageButton"
                AutomationProperties.Name="Paste image"
                Command="{x:Bind ViewModel.ImageSearch.PasteCommand, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Search with the image in the clipboard (Ctrl+V)"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Paste" />
                    <TextBlock Text="Paste image" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  The same as the manga Search page: the search is MediaSearchView's  -->
        <views:MediaSearchView x:Name="TitleView" Grid.Row="1" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        <views:ImageSearchView
            x:Name="ImageView"
            Grid.Row="1"
            Margin="16,12,16,16"
            ViewModel="{x:Bind ViewModel.ImageSearch, Mode=OneWay}"
            Visibility="Collapsed" />
    </Grid>
</Page>
