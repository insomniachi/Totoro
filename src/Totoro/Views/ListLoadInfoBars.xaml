<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.ListLoadInfoBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Totoro.Views">

    <!--  Why a page of the user's list is empty (see ListLoadState): not signed in, or loading failed  -->
    <StackPanel Spacing="8">
        <InfoBar
            Title="Not signed in"
            IsClosable="False"
            IsOpen="{x:Bind local:ListLoadInfoBars.HasText(State.SignInMessage), Mode=OneWay}"
            Message="{x:Bind State.SignInMessage, Mode=OneWay}"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind State.SignInCommand, Mode=OneWay}" Content="Sign in" />
            </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            Title="Couldn't load"
            IsClosable="False"
            IsOpen="{x:Bind local:ListLoadInfoBars.HasText(State.Error), Mode=OneWay}"
            Message="{x:Bind State.Error, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind State.RetryCommand, Mode=OneWay}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>
    </StackPanel>
</UserControl>
