<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:uiNavigation="using:Totoro.UI.Navigation">

    <!--
        Playgrounds for reusable pieces of the app, one per tab. Each is a page of its own, which the "test" navigator shows
        in the frame below; the tabs' Tags are their navigation keys (see TestViewModel).
    -->
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar Margin="-8,0,0,0" SelectionChanged="OnPlaygroundSelected">
            <SelectorBarItem
                IsSelected="True"
                Tag="Test.HtmlRenderer"
                Text="HTML renderer" />
            <SelectorBarItem Tag="Test.SettingsEditor" Text="Settings editor" />
            <SelectorBarItem Tag="Test.AgentTools" Text="Agent tools" />
            <SelectorBarItem Tag="Test.BuiltInPlayer" Text="Built-in player" />
        </SelectorBar>

        <Frame Grid.Row="1">
            <Interactivity:Interaction.Behaviors>
                <uiNavigation:RegisterForNavigationBehavior NavigatorKey="test" />
            </Interactivity:Interaction.Behaviors>
        </Frame>
    </Grid>
</Page>
