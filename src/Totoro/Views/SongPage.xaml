<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.SongPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:helpers="using:Totoro.Helpers">

    <!--  A song from the title bar's search: the anime it's from, then its card as in the Music tab  -->
    <ScrollView>
        <StackPanel Padding="16" Spacing="16">
            <Button
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.AutomationId="SongAnimeButton"
                AutomationProperties.Name="{x:Bind ViewModel.Heading, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.OpenAnimeCommand}"
                ToolTipService.ToolTip="Open the anime">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Height="112"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.Anime.Image), Mode=OneTime}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Song.Title, Mode=OneTime}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Heading, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
            <TextBlock
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(ViewModel.Message), Mode=OneWay}" />
            <controls:SongCard Song="{x:Bind ViewModel.Song, Mode=OneTime}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="From AnimeThemes." />
        </StackPanel>
    </ScrollView>
</Page>
