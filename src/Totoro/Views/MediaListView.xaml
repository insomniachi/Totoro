<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.MediaListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filtering="using:Totoro.Core.Filtering"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views"
    xmlns:manga="using:Totoro.Core.Modules.Manga"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:toolkitui="using:CommunityToolkit.WinUI"
    xmlns:ui="using:Totoro.UI"
    xmlns:overlays="using:Totoro.UI.Controls.AnimeCardOverlays"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:NullableNumberConverter x:Key="NullableNumber" />

        <!--  Actions of each card, on hover and in its right-click menu; each Command receives the card's AnimeModel  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Play}"
                Label="Play"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.BingeCommand}"
                Icon="{toolkitui:FontIconSource Glyph=&#xE8EE;}"
                Label="Play from here" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit tracking"
                OffListIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                OffListLabel="Add to list"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.DownloadCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Download}"
                Label="Download" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditSettingsCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Setting}"
                Label="Settings" />
        </overlays:CardActionCollection>
        <!--  The manga list's actions; each Command receives the card's MangaModel  -->
        <overlays:CardActionCollection x:Key="MangaCardActions">
            <overlays:CardAction
                Command="{x:Bind commands:MangaCommands.Shared.ReadCommand}"
                Icon="{toolkitui:FontIconSource Glyph=&#xE736;}"
                Label="Read"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:MangaCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit tracking"
                OffListIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                OffListLabel="Add to list"
                ShowOnHover="True" />
        </overlays:CardActionCollection>

        <!--  A card as the list's kind wants it: the same card, with each kind's actions and overlays  -->
        <local:MediaTemplateSelector x:Key="CardTemplate">
            <local:MediaTemplateSelector.Anime>
                <DataTemplate x:DataType="anime:AnimeModel">
                    <controls:AnimeCard Anime="{x:Bind}" Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}">
                        <Interactivity:Interaction.Behaviors>
                            <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                            <overlays:NextEpisodeOverlay />
                            <overlays:NewEpisodesOverlay />
                            <overlays:AiringStatusOverlay />
                            <overlays:WatchProgressOverlay />
                            <overlays:HoverEffectsBehavior />
                        </Interactivity:Interaction.Behaviors>
                    </controls:AnimeCard>
                </DataTemplate>
            </local:MediaTemplateSelector.Anime>
            <local:MediaTemplateSelector.Manga>
                <DataTemplate x:DataType="manga:MangaModel">
                    <controls:AnimeCard Media="{x:Bind}" Command="{x:Bind commands:MangaCommands.Shared.ShowDetailsCommand}">
                        <Interactivity:Interaction.Behaviors>
                            <overlays:ActionsOverlay Actions="{StaticResource MangaCardActions}" />
                            <overlays:WatchProgressOverlay />
                            <overlays:HoverEffectsBehavior />
                        </Interactivity:Interaction.Behaviors>
                    </controls:AnimeCard>
                </DataTemplate>
            </local:MediaTemplateSelector.Manga>
        </local:MediaTemplateSelector>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <toolkit:Segmented
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="16,0,16,16"
            HorizontalAlignment="Center"
            ItemsSource="{x:Bind ViewModel.StatusFilter.Options, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.StatusFilter.SelectedIndex, Mode=TwoWay}">
            <toolkit:Segmented.ItemTemplate>
                <!--  The item's default style sets its own FontSize, so size the text here rather than on the Segmented  -->
                <DataTemplate x:DataType="filtering:FilterOption">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center">
                            <ContentPresenter Content="{x:Bind ui:Icons.FromKey(IconKey)}" />
                        </Viewbox>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyLargeStrongTextBlockStyle}"
                            Text="{x:Bind Label}" />
                    </StackPanel>
                </DataTemplate>
            </toolkit:Segmented.ItemTemplate>
            <toolkit:Segmented.ItemContainerStyle>
                <!--  No BasedOn needed: the control's theme style (and its template) still applies underneath  -->
                <Style TargetType="toolkit:SegmentedItem">
                    <Setter Property="MinWidth" Value="160" />
                    <Setter Property="Padding" Value="24,12" />
                </Style>
            </toolkit:Segmented.ItemContainerStyle>

        </toolkit:Segmented>

        <!--  The filters (title, genres, season, year) and sorting show only while Filters is on; it's right of the tabs  -->
        <ToggleButton
            Grid.ColumnSpan="2"
            Margin="16,0,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="Filters"
            IsChecked="{x:Bind ViewModel.ShowFilters, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="16" Glyph="&#xE71C;" />
                <TextBlock Text="Filters" />
            </StackPanel>
        </ToggleButton>

        <!--
            As on the search page: the filters in a panel right of the cards, on a raised surface, scrolling on their own.
            16 left of it plus the cards' 16 margin: the same 32 gap as between the cards.
        -->
        <local:ListLoadInfoBars
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="16,0,16,8"
            State="{x:Bind ViewModel.LoadState}"
            Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.LoadState.HasMessage), Mode=OneWay}" />

        <Border
            Grid.Row="2"
            Grid.Column="1"
            Width="320"
            Margin="16,8,16,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.ShowFilters, Mode=OneWay}">
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation
                    From="0"
                    To="1"
                    Duration="0:0:0.2" />
                <animations:TranslationAnimation
                    From="16,0,0"
                    To="0"
                    Duration="0:0:0.2" />
            </animations:Implicit.ShowAnimations>
            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation
                    From="1"
                    To="0"
                    Duration="0:0:0.15" />
                <animations:TranslationAnimation
                    From="0"
                    To="16,0,0"
                    Duration="0:0:0.15" />
            </animations:Implicit.HideAnimations>
            <ScrollView>
                <StackPanel Padding="16" Spacing="12">
                    <!--  The panel's heading, with clearing every filter at its end  -->
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Filters" />
                        <HyperlinkButton
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Clear all filters"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            Content="Clear all"
                            IsEnabled="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
                            ToolTipService.ToolTip="Clear all filters" />
                    </Grid>

                    <TextBox
                        Header="Title"
                        PlaceholderText="Any title"
                        Text="{x:Bind ViewModel.TitleFilter.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Genres" />
                        <DropDownButton
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Genres"
                            Content="{x:Bind ViewModel.GenreFilter.Label, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="360">
                                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.GenreFilter.Options}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="anime:GenreOption">
                                                    <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <!--  Anime only: manga have no seasons  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsAnime, Mode=OneWay}">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="Season"
                            ItemsSource="{x:Bind ViewModel.SeasonFilter.Seasons}"
                            SelectedItem="{x:Bind ViewModel.SeasonFilter.Season, Mode=TwoWay}" />

                        <!--  As on the search page: any, one year, or a range; a range may be open at either end  -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Year" />
                            <toolkit:Segmented
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Year filter"
                                SelectedIndex="{x:Bind ViewModel.SeasonFilter.YearModeIndex, Mode=TwoWay}">
                                <toolkit:SegmentedItem Content="Any" />
                                <toolkit:SegmentedItem Content="Year" />
                                <toolkit:SegmentedItem Content="Range" />
                            </toolkit:Segmented>
                            <!--  TargetType converts the cases' names to the enum, to compare them with the value  -->
                            <toolkit:SwitchPresenter TargetType="anime:YearFilterMode" Value="{x:Bind ViewModel.SeasonFilter.YearMode, Mode=OneWay}">
                                <toolkit:Case Value="Year">
                                    <NumberBox
                                        AutomationProperties.Name="Year"
                                        Maximum="{x:Bind ViewModel.SeasonFilter.LatestYear}"
                                        Minimum="1940"
                                        PlaceholderText="e.g. 2016"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.SeasonFilter.Year, Mode=TwoWay, Converter={StaticResource NullableNumber}, ConverterParameter=Int32}" />
                                </toolkit:Case>
                                <toolkit:Case Value="Range">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            AutomationProperties.Name="From year"
                                            Maximum="{x:Bind ViewModel.SeasonFilter.LatestYear}"
                                            Minimum="1940"
                                            PlaceholderText="Any"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.SeasonFilter.MinimumYear, Mode=TwoWay, Converter={StaticResource NullableNumber}, ConverterParameter=Int32}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="to" />
                                        <NumberBox
                                            Grid.Column="2"
                                            AutomationProperties.Name="To year"
                                            Maximum="{x:Bind ViewModel.SeasonFilter.LatestYear}"
                                            Minimum="1940"
                                            PlaceholderText="Any"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.SeasonFilter.MaximumYear, Mode=TwoWay, Converter={StaticResource NullableNumber}, ConverterParameter=Int32}" />
                                    </Grid>
                                </toolkit:Case>
                            </toolkit:SwitchPresenter>
                        </StackPanel>
                    </StackPanel>

                    <!--  The label is outside the row so the dropdown and the order button line up at the same height  -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sort by" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Sort by"
                                ItemsSource="{x:Bind ViewModel.SortOptions}"
                                SelectedItem="{x:Bind ViewModel.Sort, Mode=TwoWay}" />
                            <!--  Shows the current order; clicking reverses it  -->
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollView>
        </Border>

        <toolkit:SwitchPresenter
            Grid.Row="2"
            TargetType="x:Boolean"
            Value="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <toolkit:Case Value="True">
                <!--  Placeholder cards laid out like the real grid, so the page doesn't jump when the list arrives  -->
                <ItemsRepeater Margin="16,8,16,16" ItemsSource="{x:Bind PlaceholderCards}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <toolkit:Shimmer CornerRadius="8" />
                                <toolkit:Shimmer
                                    Grid.Row="1"
                                    Height="20"
                                    Margin="24,0"
                                    CornerRadius="4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="32"
                            MinItemHeight="400"
                            MinItemWidth="250"
                            MinRowSpacing="32" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </toolkit:Case>
            <toolkit:Case IsDefault="True" Value="False">
                <Grid>
                    <!--  No cards: why, and what to do about it (see UserListViewModel.Empty)  -->
                    <StackPanel
                        MaxWidth="400"
                        Margin="16,0,16,64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <FontIcon
                            Margin="0,0,0,8"
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="{x:Bind ViewModel.Empty.Glyph, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Empty.Title, Mode=OneWay}"
                            TextAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Empty.Text, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.GoToDiscoverCommand}"
                            Content="Go to Discover"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.Empty.OffersDiscover, Mode=OneWay}" />
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            Content="Clear filters"
                            Visibility="{x:Bind ViewModel.Empty.OffersClearFilters, Mode=OneWay}" />
                    </StackPanel>
                    <ScrollView x:Name="ListScrollView" ViewChanged="OnListViewChanged">
                        <ItemsRepeater
                            Margin="16,8,16,16"
                            ItemTemplate="{StaticResource CardTemplate}"
                            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                            <ItemsRepeater.ItemTransitionProvider>
                                <controls:CardCollectionTransitionProvider />
                            </ItemsRepeater.ItemTransitionProvider>
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="32"
                                    MinItemHeight="400"
                                    MinItemWidth="250"
                                    MinRowSpacing="32" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollView>

                    <!--  Shown once the list is scrolled down by more than a screen (see OnListViewChanged)  -->
                    <Button
                        x:Name="GoToTopButton"
                        Width="48"
                        Height="48"
                        Margin="0,0,32,32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Back to top"
                        BorderThickness="1"
                        Click="OnGoToTopClick"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Back to top"
                        Visibility="Collapsed">
                        <Button.Resources>
                            <!--  Thin black ring like the cards' floating buttons; AccentButtonStyle swaps these brushes per state  -->
                            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Black" />
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Black" />
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Black" />
                        </Button.Resources>
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation
                                From="0"
                                To="1"
                                Duration="0:0:0.2" />
                            <animations:TranslationAnimation
                                From="0,24,0"
                                To="0"
                                Duration="0:0:0.2" />
                        </animations:Implicit.ShowAnimations>
                        <animations:Implicit.HideAnimations>
                            <animations:OpacityAnimation
                                From="1"
                                To="0"
                                Duration="0:0:0.15" />
                            <animations:TranslationAnimation
                                From="0"
                                To="0,24,0"
                                Duration="0:0:0.15" />
                        </animations:Implicit.HideAnimations>
                        <FontIcon FontSize="18" Glyph="&#xE74A;" />
                    </Button>
                </Grid>
            </toolkit:Case>
        </toolkit:SwitchPresenter>
    </Grid>
</UserControl>
