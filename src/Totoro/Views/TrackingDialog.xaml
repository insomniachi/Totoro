<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.TrackingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  The tracker's own fields (see TrackingForm), one control per kind  -->
        <local:TrackingFieldTemplateSelector x:Key="FieldTemplateSelector">
            <local:TrackingFieldTemplateSelector.Text>
                <DataTemplate x:DataType="anime:TextField">
                    <TextBox
                        AcceptsReturn="{x:Bind IsMultiline}"
                        Header="{x:Bind Label}"
                        Text="{x:Bind Value, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </local:TrackingFieldTemplateSelector.Text>
            <local:TrackingFieldTemplateSelector.Number>
                <DataTemplate x:DataType="anime:NumberField">
                    <NumberBox
                        Header="{x:Bind Label}"
                        Maximum="{x:Bind Maximum}"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind Value, Mode=TwoWay}" />
                </DataTemplate>
            </local:TrackingFieldTemplateSelector.Number>
            <local:TrackingFieldTemplateSelector.Toggle>
                <DataTemplate x:DataType="anime:ToggleField">
                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind Value, Mode=TwoWay}" />
                </DataTemplate>
            </local:TrackingFieldTemplateSelector.Toggle>
            <local:TrackingFieldTemplateSelector.Choice>
                <DataTemplate x:DataType="anime:ChoiceField">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Header="{x:Bind Label}"
                        ItemsSource="{x:Bind Choices}"
                        SelectedItem="{x:Bind Value, Mode=TwoWay}" />
                </DataTemplate>
            </local:TrackingFieldTemplateSelector.Choice>
        </local:TrackingFieldTemplateSelector>
    </UserControl.Resources>

    <!--  A fixed width: measured without one, the two-column grids size their columns to their content instead of halving it  -->
    <StackPanel Width="400" Spacing="16">
        <ComboBox
            HorizontalAlignment="Stretch"
            Header="Status"
            ItemsSource="{x:Bind ViewModel.Statuses}"
            SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StatusOption">
                    <TextBlock Text="{x:Bind Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <NumberBox
                Header="Episodes watched"
                Maximum="{x:Bind ViewModel.MaxEpisodes}"
                Minimum="0"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.WatchedEpisodes, Mode=TwoWay}" />
            <!--  The score, picked the way the tracker's scale is (see ScoreStyle)  -->
            <NumberBox
                Grid.Column="1"
                Header="{x:Bind ViewModel.ScoreHeader, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.Form.ScoreMax, Mode=OneWay}"
                Minimum="0"
                NumberFormatter="{x:Bind ViewModel.ScoreFormatter, Mode=OneWay}"
                SmallChange="{x:Bind ViewModel.Form.ScoreStep, Mode=OneWay}"
                SpinButtonPlacementMode="Inline"
                Visibility="{x:Bind ViewModel.IsNumberScore, Mode=OneWay}"
                Value="{x:Bind ViewModel.Score, Mode=TwoWay}" />
            <StackPanel
                Grid.Column="1"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsStarScore, Mode=OneWay}">
                <TextBlock Text="Score" />
                <RatingControl
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Score"
                    IsClearEnabled="True"
                    MaxRating="{x:Bind ViewModel.StarCount, Mode=OneWay}"
                    Value="{x:Bind ViewModel.StarValue, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsSmileyScore, Mode=OneWay}">
                <TextBlock Text="Score" />
                <toolkit:Segmented
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Score"
                    SelectedIndex="{x:Bind ViewModel.SmileyIndex, Mode=TwoWay}">
                    <!--  The item's default style sets its own FontSize, so size the faces on their TextBlocks  -->
                    <toolkit:SegmentedItem AutomationProperties.Name="Disliked">
                        <TextBlock FontSize="20" Text="🙁" />
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem AutomationProperties.Name="Neutral">
                        <TextBlock FontSize="20" Text="😐" />
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem AutomationProperties.Name="Liked">
                        <TextBlock FontSize="20" Text="🙂" />
                    </toolkit:SegmentedItem>
                </toolkit:Segmented>
            </StackPanel>
        </Grid>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker
                HorizontalAlignment="Stretch"
                Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                Header="Start date"
                PlaceholderText="Not started" />
            <CalendarDatePicker
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Date="{x:Bind ViewModel.FinishDate, Mode=TwoWay}"
                Header="Finish date"
                PlaceholderText="Not finished" />
        </Grid>

        <ItemsControl ItemTemplateSelector="{StaticResource FieldTemplateSelector}" ItemsSource="{x:Bind ViewModel.Form.Fields, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:CommonConverters.InvertedBooleanToVisibility(ViewModel.CanConfirm), Mode=OneWay}" />
    </StackPanel>
</UserControl>
