<?xml version="1.0" encoding="utf-8" ?>
<!--
    The player's controls, laid out like WinUI's MediaTransportControls (its default template's sizes and order), with the
    app's own additions: the seek bar in sections (opening, ending), the episodes, skipping ahead, the room. Its own control,
    not a MediaTransportControls template, so any video backend can use it: it only talks to PlayerViewModel.
-->
<UserControl
    x:Class="Totoro.Views.Player.PlayerTransportControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views.Player"
    xmlns:media="using:Totoro.Core.Modules.Media"
    xmlns:player="using:Totoro.ViewModels.Player"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">
    <UserControl.Resources>
        <!--  Buttons outside the bar (in its pop-ups), sized like the bar's  -->
        <Style
            x:Key="PlayerButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <!--  The bar's buttons, as MediaTransportControls' (MediaTransportControlsAppBarButtonWidth/Height)  -->
        <Style
            x:Key="TransportButtonStyle"
            BasedOn="{StaticResource DefaultAppBarButtonStyle}"
            TargetType="AppBarButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="AllowFocusOnInteraction" Value="True" />
            <Setter Property="LabelPosition" Value="Collapsed" />
        </Style>
        <!--  MediaTransportControls' overrides, so the icon and hover square sit centred in the 40x40 button  -->
        <x:Double x:Key="AppBarThemeMinHeight">40</x:Double>
        <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
        <!--  High-opacity background for flyouts like the episode list, ensuring text and details are completely legible  -->
        <SolidColorBrush
            x:Key="FlyoutBackgroundBrush"
            Opacity="0.9"
            Color="#FA141414" />
    </UserControl.Resources>

    <Grid
        x:Name="Panel"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The seek bar: its track is in sections, the opening and ending coloured apart from the episode  -->
        <Grid Margin="7,2,7,1">
            <Grid
                x:Name="SeekTrack"
                Height="4"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                SizeChanged="OnSeekTrackSizeChanged">
                <Canvas x:Name="TrackSections" />
                <Canvas x:Name="PlayedSections" />
                <!--  A notch where the episode counts as watched, until it has been (see DrawWatchedMark)  -->
                <Canvas x:Name="WatchedMark" />
            </Grid>
            <Slider
                x:Name="SeekBar"
                Height="32"
                VerticalAlignment="Center"
                AutomationProperties.Name="Seek"
                ThumbToolTipValueConverter="{x:Bind TimeConverter, Mode=OneTime}"
                ValueChanged="OnSeekBarValueChanged">
                <!--  Its own track is hidden: the sections under it are the track  -->
                <Slider.Resources>
                    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
                </Slider.Resources>
            </Slider>
        </Grid>

        <!--  Under the bar, at its ends: where it is, and how long it is (with a check once it's been marked watched)  -->
        <Grid
            Grid.Row="1"
            Height="16"
            Margin="7,0,7,2">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="4">
                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Marked as watched"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xEC61;"
                    ToolTipService.ToolTip="Marked as watched"
                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.IsWatched), Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--
            The buttons in MediaTransportControls' three groups: volume and tracks at the left, the transport in the
            middle (play centred), the rest at the right
        -->
        <Grid Grid.Row="2" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
            <AppBarButton Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="Volume" ToolTipService.ToolTip="Volume">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind local:PlayerTransportControls.VolumeGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <Flyout Placement="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="MuteButton"
                                AutomationProperties.Name="{x:Bind local:PlayerTransportControls.MuteName(ViewModel.IsMuted, Shortcuts.MuteKeys), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                Style="{StaticResource PlayerButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:PlayerTransportControls.MuteName(ViewModel.IsMuted, Shortcuts.MuteKeys), Mode=OneWay}">
                                <FontIcon FontSize="16" Glyph="{x:Bind local:PlayerTransportControls.VolumeGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" />
                            </Button>
                            <Slider
                                Width="190"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Volume"
                                IsThumbToolTipEnabled="False"
                                Maximum="100"
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                            <TextBlock
                                Width="28"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind local:PlayerTransportControls.VolumeText(ViewModel.Volume), Mode=OneWay}"
                                TextAlignment="Right" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.Name="Audio and subtitles"
                ToolTipService.ToolTip="Audio and subtitles"
                Visibility="{x:Bind local:PlayerTransportControls.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xED1E;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout Opening="OnTracksMenuOpening" Placement="Top" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <!--  Anime4K's modes: only mpv has them (its shaders), as its config binds them to keys  -->
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.Name="Anime4K"
                ToolTipService.ToolTip="Anime4K upscaling"
                Visibility="{x:Bind local:PlayerTransportControls.VisibleIfAny(ViewModel.ShaderModes), Mode=OneTime}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout Opening="OnShaderMenuOpening" Placement="Top" />
                </AppBarButton.Flyout>
            </AppBarButton>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">

            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.Name="Back 10 seconds"
                Command="{x:Bind ViewModel.SeekByCommand}"
                ToolTipService.ToolTip="Back 10 seconds"
                Visibility="{x:Bind local:PlayerTransportControls.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                <AppBarButton.CommandParameter>
                    <x:Double>-10</x:Double>
                </AppBarButton.CommandParameter>
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xED3C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.Name="Previous episode"
                Command="{x:Bind ViewModel.EpisodeList.PreviousEpisodeCommand}"
                IsEnabled="{x:Bind ViewModel.EpisodeList.HasPreviousEpisode, Mode=OneWay}"
                ToolTipService.ToolTip="Previous episode"
                Visibility="{x:Bind local:PlayerTransportControls.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xF8AC;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                x:Name="PlayPauseButton"
                AutomationProperties.Name="{x:Bind local:PlayerTransportControls.PlayPauseName(ViewModel.IsPlaying, Shortcuts.PlayPauseKeys), Mode=OneWay}"
                Command="{x:Bind ViewModel.PlayPauseCommand}"
                ToolTipService.ToolTip="{x:Bind local:PlayerTransportControls.PlayPauseName(ViewModel.IsPlaying, Shortcuts.PlayPauseKeys), Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind local:PlayerTransportControls.PlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.Name="Next episode"
                Command="{x:Bind ViewModel.NextEpisodeCommand, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.EpisodeList.HasNextEpisode, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind local:PlayerTransportControls.WithKey('Next episode', Shortcuts.NextEpisodeKeys), Mode=OneTime}"
                Visibility="{x:Bind local:PlayerTransportControls.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xF8AD;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.Name="Forward 30 seconds"
                Command="{x:Bind ViewModel.SeekByCommand}"
                ToolTipService.ToolTip="Forward 30 seconds"
                Visibility="{x:Bind local:PlayerTransportControls.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                <AppBarButton.CommandParameter>
                    <x:Double>30</x:Double>
                </AppBarButton.CommandParameter>
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xED3D;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </StackPanel>

        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <!--  An opening's length, or skipping the OP/ED while it plays  -->
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.AutomationId="SkipButton"
                AutomationProperties.Name="{x:Bind ViewModel.SkipButtonToolTip, Mode=OneWay}"
                Command="{x:Bind ViewModel.SkipAheadCommand}"
                ToolTipService.ToolTip="{x:Bind ViewModel.SkipButtonToolTip, Mode=OneWay}"
                Visibility="{x:Bind local:PlayerTransportControls.SkipButtonVisibility(ViewModel.IsClip, ViewModel.IsSkipButtonVisible), Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xEB9D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!--  Watching together: who's in the room (with a badge of how many others), and what each is playing  -->
            <Grid Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.Room.IsInRoom), Mode=OneWay}">
                <!--  The badge sits on the button's corner, outside it: the button clips its content  -->
                <Grid>
                    <AppBarButton Style="{StaticResource TransportButtonStyle}"
                        x:Name="RoomButton"
                        AutomationProperties.AutomationId="RoomButton"
                        AutomationProperties.Name="{x:Bind local:PlayerTransportControls.RoomButtonName(ViewModel.Room.RoomPeople), Mode=OneWay}"
                        Click="OnRoomButtonClick"
                        ToolTipService.ToolTip="{x:Bind local:PlayerTransportControls.RoomButtonName(ViewModel.Room.RoomPeople), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE716;" />
                        </AppBarButton.Icon>
                        <!--  Above the controls, clear of the seek bar, like the episode list (see OnRoomButtonClick)  -->
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="RoomFlyout" Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{StaticResource FlyoutBackgroundBrush}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel
                                    MinWidth="240"
                                    MaxWidth="360"
                                    RequestedTheme="Dark"
                                    Spacing="12">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Watching together" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Room.RoomPeople, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="media:RoomPerson">
                                                <StackPanel
                                                    Margin="0,0,0,12"
                                                    Orientation="Horizontal"
                                                    Spacing="12">
                                                    <PersonPicture
                                                        Width="32"
                                                        Height="32"
                                                        DisplayName="{x:Bind Name, Mode=OneTime}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind local:PlayerTransportControls.PersonName(Name, IsYou), Mode=OneTime}" />
                                                        <TextBlock
                                                            MaxWidth="300"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind local:PlayerTransportControls.PersonPlaying(Playing), Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!--  Said to the room on Enter; the others see it over their video, or in Syncplay's chat  -->
                                    <TextBox
                                        AutomationProperties.AutomationId="RoomChatBox"
                                        AutomationProperties.Name="Say something to the room"
                                        KeyDown="OnRoomChatKeyDown"
                                        MaxLength="150"
                                        PlaceholderText="Say something to the room"
                                        Text="{x:Bind ViewModel.Room.RoomChat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </AppBarButton>
                    <InfoBadge
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Value="{x:Bind local:PlayerTransportControls.OthersInRoom(ViewModel.Room.RoomPeople), Mode=OneWay}"
                        Visibility="{x:Bind local:PlayerTransportControls.BadgeVisibility(ViewModel.Room.RoomPeople), Mode=OneWay}" />
                </Grid>
            </Grid>
            <!--  The episode list pops up above the controls, over this button: each episode's thumbnail and details; picking one plays it  -->
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                x:Name="EpisodesButton"
                AutomationProperties.Name="Episodes"
                Click="OnEpisodesButtonClick"
                ToolTipService.ToolTip="{x:Bind local:PlayerTransportControls.WithKey('Episodes', Shortcuts.EpisodesKeys), Mode=OneTime}"
                Visibility="{x:Bind local:PlayerTransportControls.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8FD;" />
                </AppBarButton.Icon>
                <FlyoutBase.AttachedFlyout>
                    <Flyout
                        x:Name="EpisodeFlyout"
                        Closed="OnEpisodeListClosed"
                        Opened="OnEpisodeListOpened"
                        Placement="Top">
                        <Flyout.FlyoutPresenterStyle>
                            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MaxWidth" Value="440" />
                                <Setter Property="MaxHeight" Value="560" />
                                <Setter Property="Background" Value="{StaticResource FlyoutBackgroundBrush}" />
                                <!--  The list scrolls itself  -->
                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid Width="400" RequestedTheme="Dark">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="16,12,8,8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="Episodes" />
                                <Button
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Close the episode list"
                                    Command="{x:Bind ViewModel.EpisodeList.ToggleEpisodeListCommand}"
                                    Style="{StaticResource PlayerButtonStyle}"
                                    ToolTipService.ToolTip="Close (Esc)">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                            <ListView
                                x:Name="EpisodeListView"
                                Grid.Row="1"
                                Padding="0,0,0,8"
                                IsItemClickEnabled="True"
                                ItemClick="OnEpisodeClick"
                                ItemsSource="{x:Bind ViewModel.EpisodeList.Episodes, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="player:EpisodeListItem">
                                        <Grid
                                            Padding="0,8"
                                            AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  The thumbnail, with where it was left off along its bottom  -->
                                            <Grid
                                                Width="128"
                                                Height="72"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Image), Mode=OneTime}" Stretch="UniformToFill" />
                                                <Border
                                                    Margin="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="2"
                                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsCurrent), Mode=OneTime}">
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="Playing" />
                                                </Border>
                                                <Grid
                                                    Height="3"
                                                    Margin="6,0,6,6"
                                                    VerticalAlignment="Bottom"
                                                    Background="#66FFFFFF"
                                                    CornerRadius="1.5"
                                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(HasProgress), Mode=OneTime}">
                                                    <Rectangle
                                                        Width="{x:Bind local:PlayerTransportControls.EpisodeProgressWidth(Progress), Mode=OneTime}"
                                                        HorizontalAlignment="Left"
                                                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </Grid>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind NumberText, Mode=OneTime}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Title, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <FontIcon
                                                        Grid.Column="2"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Glyph="&#xE930;"
                                                        Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsWatched), Mode=OneTime}" />
                                                </Grid>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Details, Mode=OneTime}"
                                                    Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Details), Mode=OneTime}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="2"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Overview, Mode=OneTime}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </AppBarButton>
            <AppBarButton Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="Aspect ratio" ToolTipService.ToolTip="{x:Bind local:PlayerTransportControls.WithKey('Aspect ratio', Shortcuts.AspectRatioKeys), Mode=OneTime}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE799;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout Opening="OnAspectRatioMenuOpening" Placement="Top" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Style="{StaticResource TransportButtonStyle}"
                AutomationProperties.AutomationId="FullScreenButton"
                AutomationProperties.Name="{x:Bind local:PlayerTransportControls.FullScreenName(ViewModel.IsFullScreen, Shortcuts.FullScreenKeys), Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                ToolTipService.ToolTip="{x:Bind local:PlayerTransportControls.FullScreenName(ViewModel.IsFullScreen, Shortcuts.FullScreenKeys), Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind local:PlayerTransportControls.FullScreenGlyph(ViewModel.IsFullScreen), Mode=OneWay}" />
                </AppBarButton.Icon>
            </AppBarButton>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
