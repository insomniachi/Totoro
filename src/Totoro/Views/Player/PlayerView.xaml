<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Views.Player.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views.Player"
    xmlns:media="using:Totoro.Core.Modules.Media"
    xmlns:player="using:Totoro.UI.Player">

    <!--
        Laid out like Windows' Media Player: the video fills the window, title bar included, with the title bar and the
        controls over it, see-through. They slide away while it plays and nothing's happening, and come back with the
        pointer or a key. Always dark, like any video player. Keys: see OnPreviewKeyDown, and the settings it reads them from.
    -->
    <Grid
        x:Name="Root"
        PointerMoved="OnPointerMoved"
        PreviewKeyDown="OnPreviewKeyDown"
        RequestedTheme="Dark">
        <Grid.Resources>
            <!--
                Behind what floats over the video (the skip button, the next episode; the controls have their own copy):
                dark enough to read, see-through enough to watch. Not acrylic: it can't blur the video, which is drawn
                apart from the XAML (a swap chain), so it'd be a flat grey.
            -->
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B3141414" />
            <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#B3000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
        </Grid.Resources>

        <!--  The title bar, over the video: the episode playing (the system draws the window buttons on the right)  -->
        <Grid
            x:Name="TitleBarArea"
            Height="48"
            Padding="16,0,0,0"
            VerticalAlignment="Top"
            Background="{StaticResource TitleBarBackgroundBrush}"
            Canvas.ZIndex="1"
            ColumnSpacing="12">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition />
            </Grid.TranslationTransition>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                Source="/Assets/Totoro.png" />
            <TextBlock
                Grid.Column="1"
                Margin="0,0,144,0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid
            x:Name="VideoArea"
            Background="Black"
            SizeChanged="OnVideoAreaSizeChanged">
            <!--  The video goes first here, in code: libvlc's view or Windows' element, by the player (see AddVideoView)  -->

            <!--  Double-clicking the video goes full screen  -->
            <Grid Background="Transparent" DoubleTapped="OnVideoDoubleTapped" />

            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{x:Bind local:PlayerView.IsBufferingShown(ViewModel.IsBuffering, ViewModel.IsStatusVisible), Mode=OneWay}"
                IsHitTestVisible="False" />

            <!--  While there's no video: starting, getting the next episode ready, or why it can't play  -->
            <Grid
                Background="#B3000000"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}">
                <StackPanel
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="{x:Bind local:PlayerView.IsWorking(ViewModel.IsStatusVisible, ViewModel.IsStatusError), Mode=OneWay}" />
                    <FontIcon
                        FontSize="32"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE783;"
                        Visibility="{x:Bind ViewModel.IsStatusError, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--  Watching together: someone joining or leaving the room, at the top in the middle, below the title bar  -->
            <ItemsControl
                Margin="0,56,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                ItemsSource="{x:Bind ViewModel.Room.RoomNotices, Mode=OneWay}">
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="-24" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="player:RoomNotice">
                        <Border
                            Margin="0,0,0,8"
                            Padding="16,12,28,12"
                            HorizontalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="{x:Bind local:PlayerView.NoticeText(Person, Text), Mode=OneTime}"
                            Background="{StaticResource OverlayBackgroundBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <PersonPicture
                                    Width="48"
                                    Height="48"
                                    DisplayName="{x:Bind Person, Mode=OneTime}" />
                                <TextBlock
                                    MaxWidth="560"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{x:Bind Person, Mode=OneTime}" />
                                    <Run Text="{x:Bind Text, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Skipping the opening (or ending), offered at the top right, below the title bar, for a few seconds  -->
            <StackPanel
                Margin="0,64,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!--  Its bar along the bottom fills until it goes  -->
                <Button
                    Padding="0"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="OfferButton"
                    AutomationProperties.Name="{x:Bind ViewModel.OfferText, Mode=OneWay}"
                    Background="{StaticResource OverlayBackgroundBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    Command="{x:Bind ViewModel.AcceptOfferCommand}"
                    ToolTipService.ToolTip="Page Up"
                    Visibility="{x:Bind ViewModel.IsOfferVisible, Mode=OneWay}">
                    <Grid>
                        <StackPanel
                            Padding="16,10"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE893;" />
                            <TextBlock Text="{x:Bind ViewModel.OfferText, Mode=OneWay}" />
                        </StackPanel>
                        <Rectangle
                            Height="3"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind ViewModel.OfferProgress, Mode=OneWay}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Button>
                <!--
                    Saving the episode as watched to the lists: a ring while it's sent to them all, which turns into a tick
                    once they're saved, then fades. Below the skip button, which may show at the same time: it fades rather than
                    collapses, so it keeps its place while hidden, and above the button it would push it down.
                -->
                <StackPanel
                    Height="40"
                    Margin="0,8,0,0"
                    Padding="8,0,16,0"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="SaveIndicator"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind local:PlayerView.SavingText(ViewModel.IsSaving, ViewModel.IsSaved), Mode=OneWay}"
                    Background="{StaticResource OverlayBackgroundBrush}"
                    CornerRadius="20"
                    IsHitTestVisible="False"
                    Opacity="{x:Bind local:PlayerView.Opaque(ViewModel.IsSaveIndicatorVisible), Mode=OneWay}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <StackPanel.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.4" />
                    </StackPanel.OpacityTransition>
                    <Grid Width="24" VerticalAlignment="Center">
                        <ProgressRing
                            Width="24"
                            Height="24"
                            IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                            Opacity="{x:Bind local:PlayerView.Opaque(ViewModel.IsSaving), Mode=OneWay}">
                            <ProgressRing.OpacityTransition>
                                <ScalarTransition />
                            </ProgressRing.OpacityTransition>
                        </ProgressRing>
                        <FontIcon
                            Width="20"
                            Height="20"
                            CenterPoint="10,10,0"
                            FontSize="20"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Glyph="&#xE73E;"
                            Opacity="{x:Bind local:PlayerView.Opaque(ViewModel.IsSaved), Mode=OneWay}"
                            Scale="{x:Bind local:PlayerView.TickScale(ViewModel.IsSaved), Mode=OneWay}">
                            <FontIcon.OpacityTransition>
                                <ScalarTransition />
                            </FontIcon.OpacityTransition>
                            <FontIcon.ScaleTransition>
                                <Vector3Transition />
                            </FontIcon.ScaleTransition>
                        </FontIcon>
                    </Grid>
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind local:PlayerView.SavingText(ViewModel.IsSaving, ViewModel.IsSaved), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!--
                The next episode, offered over the video whether or not the controls show: at the bottom right, 24 from the
                edges (above the controls while they show)
            -->
            <Grid Margin="0,0,24,0">
                <StackPanel
                    x:Name="Offers"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="12">
                    <!--  Moves down with the controls as they hide  -->
                    <StackPanel.TranslationTransition>
                        <Vector3Transition />
                    </StackPanel.TranslationTransition>
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!--
                        The next episode: its thumbnail, with its number and title, the countdown if it plays by itself, and
                        the buttons over the bottom of it (on a shade, so they read over any image)
                    -->
                    <Grid
                        Width="360"
                        Height="{x:Bind local:PlayerView.NextCardHeight(ViewModel.NextImage), Mode=OneWay}"
                        Background="{StaticResource OverlayBackgroundBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind ViewModel.IsNextVisible, Mode=OneWay}">
                        <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.NextImage), Mode=OneWay}" Stretch="UniformToFill" />
                        <StackPanel
                            Padding="16,24,16,16"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                            <StackPanel.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="0.15" Color="#99000000" />
                                    <GradientStop Offset="0.4" Color="#CC000000" />
                                    <GradientStop Offset="1" Color="#E6000000" />
                                </LinearGradientBrush>
                            </StackPanel.Background>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind local:PlayerView.UpNext(ViewModel.NextTitle), Mode=OneWay}" />
                            <TextBlock
                                MaxLines="2"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.NextName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.NextCountdown, Mode=OneWay}"
                                Visibility="{x:Bind local:PlayerView.VisibleIfAny(ViewModel.NextCountdown), Mode=OneWay}" />
                            <StackPanel
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.PlayNextCommand}"
                                    Content="Play now"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="N" />
                                <Button Command="{x:Bind ViewModel.DismissNextCommand}" Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

        </Grid>

        <!--  Under the title bar: the anime's title logo, when it has one, coming and going with it; then short messages, e.g. "Skipped the opening", which stay, each under the one before  -->
        <StackPanel
            Margin="24,56,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Spacing="8">
            <Image
                x:Name="TitleLogo"
                MaxWidth="320"
                MaxHeight="96"
                HorizontalAlignment="Left"
                Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.Logo), Mode=OneWay}"
                Stretch="Uniform">
                <Image.OpacityTransition>
                    <ScalarTransition />
                </Image.OpacityTransition>
                <Image.TranslationTransition>
                    <Vector3Transition />
                </Image.TranslationTransition>
            </Image>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Messages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="player:PlayerMessage">
                        <Border
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Background="#CC000000"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  The controls: a panel floating over the bottom of the video, as wide as MediaTransportControls at most  -->
        <local:PlayerTransportControls
            x:Name="Controls"
            MaxWidth="720"
            Margin="12"
            VerticalAlignment="Bottom"
            SizeChanged="OnControlsSizeChanged">
            <local:PlayerTransportControls.OpacityTransition>
                <ScalarTransition />
            </local:PlayerTransportControls.OpacityTransition>
            <local:PlayerTransportControls.TranslationTransition>
                <Vector3Transition />
            </local:PlayerTransportControls.TranslationTransition>
        </local:PlayerTransportControls>
    </Grid>
</UserControl>
