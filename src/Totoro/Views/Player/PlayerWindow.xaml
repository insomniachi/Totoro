<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Totoro.Views.Player.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:local="using:Totoro.Views.Player"
    xmlns:player="using:Totoro.ViewModels.Player"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows">

    <!--
        Laid out like Windows' Media Player: the video fills the window, title bar included, with the title bar and the
        controls over it, see-through. They slide away while it plays and nothing's happening, and come back with the
        pointer or a key. Always dark, like any video player. Keys: see OnPreviewKeyDown.
    -->
    <Grid
        x:Name="Root"
        PointerMoved="OnPointerMoved"
        PreviewKeyDown="OnPreviewKeyDown"
        RequestedTheme="Dark">
        <Grid.Resources>
            <!--  Plain icons until hovered, as in Media Player  -->
            <Style
                x:Key="PlayerButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="2,0" />
            </Style>

            <!--  The play button's ring  -->
            <LinearGradientBrush x:Key="PlayRingBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}" />
                <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark1}" />
            </LinearGradientBrush>
            <!--
                Behind what floats over the video (the controls, the skip button): dark enough to read, see-through
                enough to watch. Not acrylic: it can't blur the video, which is drawn apart from the XAML (a swap chain),
                so it'd be a flat grey.
            -->
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B3141414" />
            <!--  High-opacity background for flyouts like the episode list, ensuring text and details are completely legible  -->
            <SolidColorBrush
                x:Key="FlyoutBackgroundBrush"
                Opacity="0.9"
                Color="#FA141414" />
            <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#B3000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
        </Grid.Resources>

        <!--  The title bar, over the video: the episode playing (the system draws the window buttons on the right)  -->
        <Grid
            x:Name="TitleBarArea"
            Height="48"
            Padding="16,0,0,0"
            VerticalAlignment="Top"
            Background="{StaticResource TitleBarBackgroundBrush}"
            Canvas.ZIndex="1"
            ColumnSpacing="12">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition />
            </Grid.TranslationTransition>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                Source="/Assets/Totoro.png" />
            <TextBlock
                Grid.Column="1"
                Margin="0,0,144,0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid
            x:Name="VideoArea"
            Background="Black"
            SizeChanged="OnVideoAreaSizeChanged">
            <vlc:VideoView
                x:Name="Video"
                Initialized="OnVideoInitialized"
                MediaPlayer="{x:Bind ViewModel.MediaPlayer, Mode=OneWay}" />

            <!--  Clicking the video plays or pauses it; double-clicking goes full screen  -->
            <Grid
                Background="Transparent"
                DoubleTapped="OnVideoDoubleTapped"
                Tapped="OnVideoTapped" />

            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{x:Bind local:PlayerWindow.IsBufferingShown(ViewModel.IsBuffering, ViewModel.IsStatusVisible), Mode=OneWay}"
                IsHitTestVisible="False" />

            <!--  While there's no video: starting, getting the next episode ready, or why it can't play  -->
            <Grid
                Background="#B3000000"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}">
                <StackPanel
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="{x:Bind local:PlayerWindow.IsWorking(ViewModel.IsStatusVisible, ViewModel.IsStatusError), Mode=OneWay}" />
                    <FontIcon
                        FontSize="32"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE783;"
                        Visibility="{x:Bind ViewModel.IsStatusError, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--  A short message, e.g. "Skipped the opening"  -->
            <Border
                Margin="16"
                Padding="12,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#CC000000"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.IsMessageVisible, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>

            <!--  Skipping the opening (or ending), offered at the top right, below the title bar, for a few seconds  -->
            <StackPanel
                Margin="0,64,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!--  Its bar along the bottom fills until it goes  -->
                <Button
                    Padding="0"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Bind ViewModel.OfferText, Mode=OneWay}"
                    Background="{StaticResource OverlayBackgroundBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    Command="{x:Bind ViewModel.AcceptOfferCommand}"
                    ToolTipService.ToolTip="Page Up"
                    Visibility="{x:Bind ViewModel.IsOfferVisible, Mode=OneWay}">
                    <Grid>
                        <StackPanel
                            Padding="16,10"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE893;" />
                            <TextBlock Text="{x:Bind ViewModel.OfferText, Mode=OneWay}" />
                        </StackPanel>
                        <Rectangle
                            Height="3"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind ViewModel.OfferProgress, Mode=OneWay}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Button>
            </StackPanel>

            <!--
                The next episode, offered over the video whether or not the controls show: at the bottom right, 24 from the
                edges (above the controls while they show)
            -->
            <Grid Margin="0,0,24,0">
                <StackPanel
                    x:Name="Offers"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="12">
                    <!--  Moves down with the controls as they hide  -->
                    <StackPanel.TranslationTransition>
                        <Vector3Transition />
                    </StackPanel.TranslationTransition>
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!--
                        The next episode: its thumbnail, with its number and title, the countdown if it plays by itself, and
                        the buttons over the bottom of it (on a shade, so they read over any image)
                    -->
                    <Grid
                        Width="360"
                        Height="{x:Bind local:PlayerWindow.NextCardHeight(ViewModel.NextImage), Mode=OneWay}"
                        Background="{StaticResource OverlayBackgroundBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind ViewModel.IsNextVisible, Mode=OneWay}">
                        <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(ViewModel.NextImage), Mode=OneWay}" Stretch="UniformToFill" />
                        <StackPanel
                            Padding="16,24,16,16"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                            <StackPanel.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="0.15" Color="#99000000" />
                                    <GradientStop Offset="0.4" Color="#CC000000" />
                                    <GradientStop Offset="1" Color="#E6000000" />
                                </LinearGradientBrush>
                            </StackPanel.Background>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind local:PlayerWindow.UpNext(ViewModel.NextTitle), Mode=OneWay}" />
                            <TextBlock
                                MaxLines="2"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.NextName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.NextCountdown, Mode=OneWay}"
                                Visibility="{x:Bind local:PlayerWindow.VisibleIfAny(ViewModel.NextCountdown), Mode=OneWay}" />
                            <StackPanel
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.PlayNextCommand}"
                                    Content="Play now"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="N" />
                                <Button Command="{x:Bind ViewModel.DismissNextCommand}" Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

        </Grid>

        <!--  The controls: a panel floating over the bottom of the video, up to a comfortable width  -->
        <Grid
            x:Name="Controls"
            MaxWidth="1000"
            Margin="16"
            Padding="24,8,24,12"
            VerticalAlignment="Bottom"
            Background="{StaticResource OverlayBackgroundBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            RowSpacing="4"
            SizeChanged="OnControlsSizeChanged">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition />
            </Grid.TranslationTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                The seek bar, the controls' full width (the times are under it): its track is in sections, the opening and
                ending coloured apart from the episode
            -->
            <Grid>
                <Grid
                    x:Name="SeekTrack"
                    Height="4"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    SizeChanged="OnSeekTrackSizeChanged">
                    <Canvas x:Name="TrackSections" />
                    <Canvas x:Name="PlayedSections" />
                    <!--  A notch where the episode counts as watched, until it has been (see DrawWatchedMark)  -->
                    <Canvas x:Name="WatchedMark" />
                </Grid>
                <Slider
                    x:Name="SeekBar"
                    AutomationProperties.Name="Seek"
                    ThumbToolTipValueConverter="{x:Bind TimeConverter}"
                    ValueChanged="OnSeekBarValueChanged">
                    <!--  Its own track is hidden: the sections under it are the track  -->
                    <Slider.Resources>
                        <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
                    </Slider.Resources>
                </Slider>
            </Grid>

            <!--  Under the bar, at its ends: where it is, and how long it is (with a check once it's been marked watched)  -->
            <!--  Pulled up into the space the slider leaves under its track, to sit just under the bar  -->
            <Grid Grid.Row="1" Margin="0,-8,0,0">
                <TextBlock
                    HorizontalAlignment="Left"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Marked as watched"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xEC61;"
                        ToolTipService.ToolTip="Marked as watched"
                        Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(ViewModel.IsWatched), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Left: Audio / Volume CommandBar with Flyout  -->
                <CommandBar
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    DefaultLabelPosition="Collapsed"
                    OverflowButtonVisibility="Collapsed">
                    <AppBarElementContainer VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="Volume"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Volume">
                            <FontIcon FontSize="16" Glyph="{x:Bind local:PlayerWindow.VolumeGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Margin="0"
                                            AutomationProperties.Name="{x:Bind local:PlayerWindow.MuteName(ViewModel.IsMuted), Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                            Style="{StaticResource PlayerButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind local:PlayerWindow.MuteName(ViewModel.IsMuted), Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="{x:Bind local:PlayerWindow.VolumeGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" />
                                        </Button>
                                        <Slider
                                            Width="160"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Volume"
                                            Maximum="100"
                                            Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="28"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind local:PlayerWindow.VolumeText(ViewModel.Volume), Mode=OneWay}"
                                            TextAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </AppBarElementContainer>
                </CommandBar>

                <!--  Center: Playback transport controls CommandBar  -->
                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    DefaultLabelPosition="Collapsed"
                    OverflowButtonVisibility="Collapsed">
                    <AppBarElementContainer VerticalAlignment="Center" Visibility="{x:Bind local:PlayerWindow.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                        <Button
                            AutomationProperties.Name="Previous episode"
                            Command="{x:Bind ViewModel.PreviousEpisodeCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPreviousEpisode, Mode=OneWay}"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Previous episode">
                            <FontIcon FontSize="16" Glyph="&#xE892;" />
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center" Visibility="{x:Bind local:PlayerWindow.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                        <Button
                            AutomationProperties.Name="Back 10 seconds"
                            Command="{x:Bind ViewModel.SeekByCommand}"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Back 10 seconds">
                            <Button.CommandParameter>
                                <x:Double>-10</x:Double>
                            </Button.CommandParameter>
                            <FontIcon FontSize="16" Glyph="&#xED3C;" />
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center">
                        <Button
                            x:Name="PlayPauseButton"
                            Width="40"
                            Height="40"
                            Margin="2,0"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind local:PlayerWindow.PlayPauseName(ViewModel.IsPlaying), Mode=OneWay}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{StaticResource PlayRingBrush}"
                            BorderThickness="2"
                            Command="{x:Bind ViewModel.PlayPauseCommand}"
                            CornerRadius="20"
                            ToolTipService.ToolTip="{x:Bind local:PlayerWindow.PlayPauseName(ViewModel.IsPlaying), Mode=OneWay}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PlayRingBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PlayRingBrush" />
                            </Button.Resources>
                            <FontIcon FontSize="16" Glyph="{x:Bind local:PlayerWindow.PlayPauseGlyph(ViewModel.IsPlaying), Mode=OneWay}" />
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center" Visibility="{x:Bind local:PlayerWindow.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                        <Button
                            AutomationProperties.Name="Forward 30 seconds"
                            Command="{x:Bind ViewModel.SeekByCommand}"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Forward 30 seconds">
                            <Button.CommandParameter>
                                <x:Double>30</x:Double>
                            </Button.CommandParameter>
                            <FontIcon FontSize="16" Glyph="&#xED3D;" />
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center" Visibility="{x:Bind local:PlayerWindow.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                        <Button
                            AutomationProperties.Name="Next episode"
                            Command="{x:Bind ViewModel.NextEpisodeCommand}"
                            IsEnabled="{x:Bind ViewModel.HasNextEpisode, Mode=OneWay}"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Next episode (N)">
                            <FontIcon FontSize="16" Glyph="&#xE893;" />
                        </Button>
                    </AppBarElementContainer>
                </CommandBar>

                <!--  Right: Episode navigation, audio/subtitles, aspect ratio, and full screen CommandBar  -->
                <CommandBar
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    DefaultLabelPosition="Collapsed"
                    OverflowButtonVisibility="Collapsed">
                    <AppBarElementContainer VerticalAlignment="Center" Visibility="{x:Bind local:PlayerWindow.SkipButtonVisibility(ViewModel.IsClip, ViewModel.IsSkipButtonVisible), Mode=OneWay}">
                        <!--  An opening's length, or skipping the OP/ED while it plays  -->
                        <Button
                            AutomationProperties.Name="{x:Bind ViewModel.SkipButtonToolTip, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SkipAheadCommand}"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SkipButtonToolTip, Mode=OneWay}">
                            <FontIcon FontSize="16" Glyph="&#xEB9D;" />
                        </Button>
                    </AppBarElementContainer>
                    <!--  The episode list pops up above the controls, over this button: each episode's thumbnail and details; picking one plays it  -->
                    <AppBarElementContainer VerticalAlignment="Center" Visibility="{x:Bind local:PlayerWindow.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                        <Button
                            x:Name="EpisodesButton"
                            AutomationProperties.Name="Episodes"
                            Click="OnEpisodesButtonClick"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Episodes (E)">
                            <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                            <FlyoutBase.AttachedFlyout>
                                <Flyout
                                    x:Name="EpisodeFlyout"
                                    Closed="OnEpisodeListClosed"
                                    Opened="OnEpisodeListOpened"
                                    Placement="Top">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MaxWidth" Value="440" />
                                            <Setter Property="MaxHeight" Value="560" />
                                            <Setter Property="Background" Value="{StaticResource FlyoutBackgroundBrush}" />
                                            <!--  The list scrolls itself  -->
                                            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Grid Width="400" RequestedTheme="Dark">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Padding="16,12,8,8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                                Text="Episodes" />
                                            <Button
                                                Margin="0"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.Name="Close the episode list"
                                                Command="{x:Bind ViewModel.ToggleEpisodeListCommand}"
                                                Style="{StaticResource PlayerButtonStyle}"
                                                ToolTipService.ToolTip="Close (Esc)">
                                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                        <ListView
                                            x:Name="EpisodeListView"
                                            Grid.Row="1"
                                            Padding="0,0,0,8"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnEpisodeClick"
                                            ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="player:EpisodeListItem">
                                                    <Grid
                                                        Padding="0,8"
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!--  The thumbnail, with where it was left off along its bottom  -->
                                                        <Grid
                                                            Width="128"
                                                            Height="72"
                                                            VerticalAlignment="Top"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            CornerRadius="4">
                                                            <Image Source="{x:Bind helpers:CommonConverters.ToImageSource(Image)}" Stretch="UniformToFill" />
                                                            <Border
                                                                Margin="4"
                                                                Padding="6,2"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="2"
                                                                Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsCurrent)}">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                                    Text="Playing" />
                                                            </Border>
                                                            <Grid
                                                                Height="3"
                                                                Margin="6,0,6,6"
                                                                VerticalAlignment="Bottom"
                                                                Background="#66FFFFFF"
                                                                CornerRadius="1.5"
                                                                Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(HasProgress)}">
                                                                <Rectangle
                                                                    Width="{x:Bind local:PlayerWindow.EpisodeProgressWidth(Progress)}"
                                                                    HorizontalAlignment="Left"
                                                                    Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                            </Grid>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                    Text="{x:Bind NumberText}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                    Text="{x:Bind Title}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <FontIcon
                                                                    Grid.Column="2"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    Glyph="&#xE930;"
                                                                    Visibility="{x:Bind helpers:CommonConverters.BooleanToVisibility(IsWatched)}" />
                                                            </Grid>
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Details}"
                                                                Visibility="{x:Bind helpers:CommonConverters.VisibleIfAny(Details)}" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                MaxLines="2"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Overview}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center" Visibility="{x:Bind local:PlayerWindow.HiddenForClips(ViewModel.IsClip), Mode=OneWay}">
                        <Button
                            AutomationProperties.Name="Audio and subtitles"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Audio and subtitles">
                            <FontIcon FontSize="16" Glyph="&#xED1E;" />
                            <Button.Flyout>
                                <MenuFlyout Opening="OnTracksMenuOpening" Placement="Top" />
                            </Button.Flyout>
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="Aspect ratio"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="Aspect ratio (A)">
                            <FontIcon FontSize="16" Glyph="&#xE799;" />
                            <Button.Flyout>
                                <MenuFlyout Opening="OnAspectRatioMenuOpening" Placement="Top" />
                            </Button.Flyout>
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="{x:Bind local:PlayerWindow.FullScreenName(ViewModel.IsFullScreen), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                            Style="{StaticResource PlayerButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:PlayerWindow.FullScreenName(ViewModel.IsFullScreen), Mode=OneWay}">
                            <FontIcon FontSize="16" Glyph="{x:Bind local:PlayerWindow.FullScreenGlyph(ViewModel.IsFullScreen), Mode=OneWay}" />
                        </Button>
                    </AppBarElementContainer>
                </CommandBar>
            </Grid>
        </Grid>
    </Grid>
</Window>
