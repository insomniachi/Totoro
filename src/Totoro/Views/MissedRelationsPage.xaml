<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.MissedRelationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:relations="using:Totoro.Core.Relations"
    xmlns:views="using:Totoro.Views">

    <Page.Resources>
        <!--  More room between the filter pills than TokenView's own; the pills' look stays its default style  -->
        <Style x:Key="FilterPillStyle" TargetType="labs:TokenItem">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!--  A watched anime that's why its franchise is here: its poster in a circle  -->
        <DataTemplate x:Key="WatchedTemplate" x:DataType="anime:AnimeModel">
            <Border
                Width="40"
                Height="40"
                AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                CornerRadius="20"
                ToolTipService.ToolTip="{x:Bind Title, Mode=OneTime}">
                <Border.Background>
                    <ImageBrush ImageSource="{x:Bind Image, Mode=OneTime}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </DataTemplate>

        <!--  A missed anime: its poster, title and what it is, which opens its details; and play and add to list  -->
        <DataTemplate x:Key="MissedTemplate" x:DataType="anime:AnimeModel">
            <Grid
                Padding="12,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand, Mode=OneTime}"
                    CommandParameter="{x:Bind}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border
                            Width="64"
                            Height="90"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Image Source="{x:Bind Image, Mode=OneTime}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneTime}" TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind views:MissedRelationsPage.Details(Relation, MediaFormat, Season, TotalEpisodes, MeanScore), Mode=OneTime}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Play"
                    Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand, Mode=OneTime}"
                    CommandParameter="{x:Bind}"
                    ToolTipService.ToolTip="Play">
                    <SymbolIcon Symbol="Play" />
                </Button>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add to list"
                    Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand, Mode=OneTime}"
                    CommandParameter="{x:Bind}"
                    ToolTipService.ToolTip="Add to list">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </Grid>
        </DataTemplate>

        <!--  A franchise: its name and the watched anime behind it, over its missed ones  -->
        <DataTemplate x:Key="GroupTemplate" x:DataType="relations:MissedRelationGroup">
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0"
                IsExpanded="True">
                <Expander.Header>
                    <StackPanel Padding="0,8" Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Title, Mode=OneTime}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Because you watched" />
                        <ItemsRepeater ItemTemplate="{StaticResource WatchedTemplate}" ItemsSource="{x:Bind Watched, Mode=OneTime}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Expander.Header>
                <ItemsRepeater ItemTemplate="{StaticResource MissedTemplate}" ItemsSource="{x:Bind Missed, Mode=OneTime}" />
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollView>
            <StackPanel Padding="16" Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sequels &amp; spin-offs you missed" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  What's shown: pills switched on and off. Tags are AnimeRelationType or AnimeMediaFormat names, comma-separated  -->
                    <!--  One row: the formats wrap in what the relation kinds leave  -->
                    <Grid VerticalAlignment="Bottom" ColumnSpacing="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:SelectableTokenView
                            AutomationProperties.Name="Relation types"
                            IsWrapped="True"
                            ItemContainerStyle="{StaticResource FilterPillStyle}"
                            SelectionChanged="OnRelationsChanged"
                            SelectionMode="Multiple">
                            <labs:TokenItem Content="Sequels &amp; prequels" IsSelected="True" Tag="Sequel,Prequel" />
                            <labs:TokenItem Content="Side stories" IsSelected="True" Tag="SideStory" />
                            <labs:TokenItem Content="Spin-offs" IsSelected="True" Tag="SpinOff" />
                        </controls:SelectableTokenView>
                        <controls:SelectableTokenView
                            Grid.Column="1"
                            AutomationProperties.Name="Formats"
                            IsWrapped="True"
                            ItemContainerStyle="{StaticResource FilterPillStyle}"
                            SelectionChanged="OnFormatsChanged"
                            SelectionMode="Multiple">
                            <labs:TokenItem Content="TV" IsSelected="True" Tag="Tv" />
                            <labs:TokenItem Content="Movie" IsSelected="True" Tag="Movie" />
                            <labs:TokenItem Content="OVA" IsSelected="True" Tag="Ova" />
                            <labs:TokenItem Content="ONA" IsSelected="True" Tag="Ona" />
                            <labs:TokenItem Content="Special" IsSelected="True" Tag="Special" />
                            <!--  Off at first, as the view model's HiddenFormats  -->
                            <labs:TokenItem Content="Music" Tag="Music" />
                        </controls:SelectableTokenView>
                    </Grid>
                    <!--  As the Library's sorting: the order, and a button that reverses it  -->
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Sort by"
                        Header="Sort by"
                        ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.Sort, Mode=TwoWay}" />
                    <Button
                        Grid.Column="2"
                        MinHeight="{ThemeResource ComboBoxMinHeight}"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="SortDirectionButton"
                        AutomationProperties.Name="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleSortDirectionCommand, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" />
                    </Button>
                </Grid>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                <ItemsRepeater ItemTemplate="{StaticResource GroupTemplate}" ItemsSource="{x:Bind ViewModel.Shown, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollView>

        <ProgressRing
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
