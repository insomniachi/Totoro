<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Totoro.Views.MissedRelationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:anime="using:Totoro.Core.Modules.Anime"
    xmlns:commands="using:Totoro.Commands"
    xmlns:controls="using:Totoro.UI.Controls"
    xmlns:overlays="using:Totoro.UI.Controls.AnimeCardOverlays"
    xmlns:toolkitui="using:CommunityToolkit.WinUI">

    <Page.Resources>
        <!--  As Discover's cards  -->
        <overlays:CardActionCollection x:Key="CardActions">
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.WatchCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Play}"
                Label="Play"
                ShowOnHover="True" />
            <overlays:CardAction
                Command="{x:Bind commands:AnimeCommands.Shared.EditTrackingCommand}"
                Icon="{toolkitui:SymbolIconSource Symbol=Edit}"
                Label="Edit tracking"
                OffListIcon="{toolkitui:SymbolIconSource Symbol=Add}"
                OffListLabel="Add to list"
                ShowOnHover="True" />
        </overlays:CardActionCollection>

        <!--  Sized by the grid, as on the Library page  -->
        <DataTemplate x:Key="CardTemplate" x:DataType="anime:AnimeModel">
            <controls:AnimeCard
                Anime="{x:Bind}"
                Command="{x:Bind commands:AnimeCommands.Shared.ShowDetailsCommand}">
                <Interactivity:Interaction.Behaviors>
                    <overlays:ActionsOverlay Actions="{StaticResource CardActions}" />
                    <overlays:ListStatusOverlay />
                    <overlays:MeanScoreOverlay />
                    <overlays:FormatSeasonOverlay />
                    <overlays:HoverEffectsBehavior />
                </Interactivity:Interaction.Behaviors>
            </controls:AnimeCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollView>
            <StackPanel Padding="16" Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sequels &amp; spin-offs you missed" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Tags are AnimeRelationType names, comma-separated; none for all  -->
                    <SelectorBar VerticalAlignment="Center" SelectionChanged="OnFilterChanged">
                        <SelectorBarItem IsSelected="True" Text="All" />
                        <SelectorBarItem Tag="Sequel,Prequel" Text="Sequels &amp; prequels" />
                        <SelectorBarItem Tag="SideStory" Text="Side stories" />
                        <SelectorBarItem Tag="SpinOff" Text="Spin-offs" />
                    </SelectorBar>
                    <!--  As the Library's sorting: the order, and a button that reverses it  -->
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Sort by"
                        Header="Sort by"
                        ItemsSource="{x:Bind ViewModel.SortOptions}"
                        SelectedItem="{x:Bind ViewModel.Sort, Mode=TwoWay}" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionName, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" />
                    </Button>
                </Grid>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                <!--  Room for a hovered card to grow (HoverEffectsBehavior)  -->
                <ItemsRepeater
                    Margin="8"
                    ItemTemplate="{StaticResource CardTemplate}"
                    ItemsSource="{x:Bind ViewModel.Shown, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <!--  As the Library's grid (MediaListView)  -->
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Fill"
                            MinColumnSpacing="32"
                            MinItemHeight="400"
                            MinItemWidth="250"
                            MinRowSpacing="32" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollView>

        <ProgressRing
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
