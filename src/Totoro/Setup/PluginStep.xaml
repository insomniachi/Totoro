<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.Setup.PluginStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Totoro.Helpers"
    xmlns:setup="using:Totoro.Setup"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Totoro.ViewModels">

    <!-- The heading stays put; the list scrolls in what's left of the step's height. -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Description, Mode=OneWay}"
            TextWrapping="Wrap" />
        <InfoBar
            x:Name="Note"
            Grid.Row="2"
            IsClosable="False"
            Severity="Informational" />
        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="3"
            Width="24"
            Height="24"
            VerticalAlignment="Top"
            AutomationProperties.Name="Loading plugins"
            IsActive="True" />
        <ScrollView Grid.Row="3">
        <ItemsControl x:Name="List" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginItemViewModel">
                    <toolkit:SettingsCard
                        Description="{x:Bind Description, Mode=OneTime}"
                        Header="{x:Bind Name, Mode=OneTime}"
                        HeaderIcon="{x:Bind helpers:CommonConverters.ToIcon(Icon, '&#xEA86;'), Mode=OneTime}">
                        <StackPanel
                            MinWidth="120"
                            HorizontalAlignment="Right"
                            Spacing="4">
                            <Button
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{x:Bind setup:PluginStep.DownloadName(Name), Mode=OneTime}"
                                Click="OnDownload"
                                Content="Download"
                                IsEnabled="{x:Bind setup:PluginStep.Not(IsBusy), Mode=OneWay}"
                                Visibility="{x:Bind ShowsNotInstalled, Mode=OneWay}" />
                            <ProgressBar
                                Maximum="100"
                                Visibility="{x:Bind IsBusy, Mode=OneWay}"
                                Value="{x:Bind Progress, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind setup:PluginStep.State(IsBuiltIn, IsInstalled, StatusText), Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollView>
    </Grid>
</UserControl>
