<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	<RootNamespace>Totoro</RootNamespace>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>Assets\Totoro.ico</ApplicationIcon>
	<!-- The release's version; the build that makes the installer sets it from the release's tag (see .github/workflows) -->
	<Version>2.0.0</Version>
	<Platforms>x64</Platforms>
	<RuntimeIdentifiers>win-x64;</RuntimeIdentifiers>
	<PublishProfile>win-$(Platform).pubxml</PublishProfile>
	<UseWinUI>true</UseWinUI>
	<EnableMsixTooling>true</EnableMsixTooling>
	<Nullable>enable</Nullable>
	<WindowsPackageType>None</WindowsPackageType>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	<!-- Published (for the installer) with the Windows App SDK's runtime, so it runs without installing that first -->
	<WindowsAppSDKSelfContained Condition="'$(_IsPublishing)' == 'true'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Styles\NavigationView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <!--  The app's icon: the exe's (and so the installer's and its shortcuts'), the title bar's and the taskbar's  -->
    <Content Include="Assets\Totoro.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Totoro.ico" CopyToOutputDirectory="PreserveNewest" />
    <!--  The modules' icons (their descriptors' Image), read from beside the exe  -->
    <Content Include="Assets\Modules\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.Shimmer" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.RangeSelector" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.TokenizingTextBox" />
    <PackageReference Include="CommunityToolkit.WinUI.Media" />
    <PackageReference Include="DevWinUI" />
    <PackageReference Include="DiscordRichPresence" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="JikanDotNet" />
    <PackageReference Include="LibVLCSharp.WinUI" />
    <PackageReference Include="MalApi.V2" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Totoro.Core\Totoro.Core.csproj" />
    <ProjectReference Include="..\Totoro.UI\Totoro.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\UserListPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Styles\NavigationView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming is off: navigation creates view models and sets Page.ViewModel via reflection
         (ActivatorUtilities / GetProperty), which the trimmer can strip. Re-enable once
         ViewMap's types are annotated with [DynamicallyAccessedMembers]. -->
    <PublishTrimmed>False</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--  Totoro's license, and the notices of what it's built with, go with the app  -->
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    libvlc (VideoLAN.LibVLC.Windows), for the built-in player (Modules\MediaPlayers\Vlc): without what playing doesn't need
    (import libraries, encoding and streaming out, visualizations, network discovery). Its license (LGPL-2.1) and where
    its source is go with it, as the LGPL asks; the package has neither.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Totoro.Tests" />
    <VlcWindowsX64ExcludeFiles Include="libvlc.lib;libvlccore.lib;plugins\access_output\%2A;plugins\stream_out\%2A;plugins\mux\%2A;plugins\visualization\%2A;plugins\services_discovery\%2A;plugins\video_splitter\%2A" />
    <None Remove="Modules\MediaPlayers\Vlc\COPYING.LIB;Modules\MediaPlayers\Vlc\NOTICE.txt" />
    <Content Include="Modules\MediaPlayers\Vlc\COPYING.LIB" Link="libvlc\win-x64\COPYING.LIB" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Modules\MediaPlayers\Vlc\NOTICE.txt" Link="libvlc\win-x64\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>