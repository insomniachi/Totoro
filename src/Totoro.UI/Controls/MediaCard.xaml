<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.UI.Controls.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Totoro.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    mc:Ignorable="d">

    <!--  One placeholder for the whole card in a ShimmerView, rather than one each for its poster, icon and title  -->
    <Border local:ShimmerView.Shape="Rectangle" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  The background and icon are the placeholder while the poster loads; the poster then fades in over them.  -->
            <Border
                Grid.RowSpan="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8,8,12,12" />
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE91B;" />

            <!--
                The outer Border clips the card to an 8px radius. At the bottom corners both the image and the title bar sit on
                that curve, and the clip's antialiased edge pixels let the image show through the title bar as a 1px fringe.
                Rounding the image's bottom corners a little more keeps it just inside the curve there; the title bar
                covers the difference.
            -->
            <Border Grid.RowSpan="2" CornerRadius="8,8,12,12">
                <!--  The fade is on a wrapper: HoverEffectsBehavior animates the image's composition visual, which rules out an OpacityTransition on it.  -->
                <Border x:Name="PosterFade" Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition />
                    </Border.OpacityTransition>
                    <Image
                        x:Name="PosterImage"
                        ImageOpened="OnPosterOpened"
                        Source="{x:Bind Media.Image, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>
            </Border>

            <Border
                Grid.Row="1"
                Height="60"
                Padding="16"
                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}">
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource BodyLargeTextBlockStyle}"
                    Text="{x:Bind Media.Title, Mode=OneWay}"
                    IsTextTrimmedChanged="OnTitleTrimmedChanged"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid x:Name="OverlayLayer" Background="Transparent" />

            <!--  On top of everything so posters with dark or light edges still stand apart from the page; HoverEffectsBehavior thickens it on hover  -->
            <Border
                x:Name="Stroke"
                Grid.RowSpan="2"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False" />

        </Grid>
    </Border>
</UserControl>
