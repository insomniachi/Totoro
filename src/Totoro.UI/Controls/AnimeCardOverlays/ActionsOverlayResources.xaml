<?xml version="1.0" encoding="utf-8" ?>
<!--
    Look of the ActionsOverlay's hover buttons, by overriding the theme resource keys the default Button style uses.
    A light translucent fill, so the cover art (blurred on hover by ImageZoomBlurBehavior) shows through and they blend
    with it; the stroke sets them apart from it. Being theme resources, they follow the card's own theme.
    High contrast keeps the default style.
-->
<ResourceDictionary
    x:Class="Totoro.UI.Controls.AnimeCardOverlays.ActionsOverlayResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonBackground" Color="#40000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#66000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#26000000" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackground" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#40FFFFFF" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
