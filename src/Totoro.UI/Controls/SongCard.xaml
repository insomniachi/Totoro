<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.UI.Controls.SongCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Totoro.UI.Controls">

    <!--
        A song's card: its label (OP1, ED2, IN), title, who sings it and the episodes it's in, with buttons to play its
        audio here and its creditless video in the media player. While its audio plays (or is paused), the spectrum, how
        far through it is, and the time, under them.
    -->
    <Grid
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        ColumnSpacing="12"
        CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
            Height="28"
            VerticalAlignment="Center"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="4">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind Song.Label, Mode=OneWay}" />
        </Border>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                IsTextSelectionEnabled="True"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Song.Title, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind Song.Details, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind local:SongCard.VisibleIfAny(Song.Details), Mode=OneWay}" />
        </StackPanel>
        <!--  Its audio, played here; its creditless video, in the media player  -->
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                AutomationProperties.Name="{x:Bind Song.AudioName, Mode=OneWay}"
                Command="{x:Bind Song.ToggleAudioCommand, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Song.AudioName, Mode=OneWay}"
                Visibility="{x:Bind Song.HasAudio, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="{x:Bind Song.AudioGlyph, Mode=OneWay}" />
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind Song.VideoName, Mode=OneWay}"
                Command="{x:Bind Song.PlayVideoCommand, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Song.VideoName, Mode=OneWay}"
                Visibility="{x:Bind Song.HasVideo, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE714;" />
            </Button>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,12,0,0"
            Spacing="8"
            Visibility="{x:Bind Song.IsCurrent, Mode=OneWay}">
            <!--  Only while it's heard: not while it's starting, or paused  -->
            <local:SongSpectrum
                Height="40"
                BarBrush="{ThemeResource AccentFillColorDefaultBrush}"
                IsActive="{x:Bind Song.IsAudible, Mode=OneWay}"
                Source="{x:Bind Song.Player, Mode=OneWay}"
                Visibility="{x:Bind Song.IsAudible, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Song position"
                    IsIndeterminate="{x:Bind Song.IsLoading, Mode=OneWay}"
                    Maximum="1"
                    Value="{x:Bind Song.Progress, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Song.TimeText, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <!--  Why it couldn't be played, e.g. the media player isn't set up  -->
        <TextBlock
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Margin="0,8,0,0"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{x:Bind Song.Error, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind local:SongCard.VisibleIfAny(Song.Error), Mode=OneWay}" />
    </Grid>
</UserControl>
