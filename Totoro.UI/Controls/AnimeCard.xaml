<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Totoro.UI.Controls.AnimeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devwinui="using:DevWinUI"
    xmlns:local="using:Totoro.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    mc:Ignorable="d">

    <devwinui:EdgeLighting
        FadeOffset="1"
        IsLighting="false"
        MidOffset="0.5"
        StrokeThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image
                Grid.RowSpan="2"
                Source="{x:Bind Anime.Image, Mode=OneWay}"
                Stretch="UniformToFill" />

            <Border
                Grid.Row="1"
                Height="60"
                Padding="16"
                Background="{StaticResource AcrylicBackgroundFillColorBaseBrush}">
                <TextBlock
                    Style="{StaticResource BodyLargeTextBlockStyle}"
                    Text="{x:Bind Anime.Title, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </Border>

            <Grid x:Name="WidgetCanvas" Background="Transparent" />

        </Grid>
    </devwinui:EdgeLighting>
</UserControl>
